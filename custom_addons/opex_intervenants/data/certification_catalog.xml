        <!-- ============================================================
             LE CRITERE ELIMINATOIRE, RECONFIGURE
             ============================================================

             `matching_criteria.xml` est en `noupdate="1"` - les ponderations
             sont du parametrage que le cluster ajuste, et un `-u` ne doit pas
             les ecraser. Le meme drapeau empeche donc de corriger le critere
             sur une base deja installee : le `<record>` modifie ne s'applique
             qu'a une installation neuve.

             C'est le second endroit de cette extension ou `noupdate` masque
             une modification, et les deux se reconnaissent au meme symptome :
             aucune erreur, et le comportement d'avant.

             Mesure : le critere continuait de comparer
             `field('certifications_souhaitees')` a
             `expert_certification_names` en mode `contains`, c'est-a-dire
             exactement la dette D1 - avec tout le reste de l'extension en
             place. Quatre tests rouges, dont celui qui compte.
        -->
        <function model="opex.matching.criteria" name="write">
            <value eval="[ref('opex_intervenants.matching_certification_audit')]"/>
            <value eval="{
                'source_expression': &quot;field('certification_ids')&quot;,
                'target_field': 'expert_certification_ref_ids',
                'match_mode': 'intersect',
                'is_conjonctif': True,
            }"/>
        </function>

