<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
         La tuile « mes candidatures »

        Troisième compteur du module, troisième clé neuve :
        `intervenants_candidature_count`. `querySelector()` ne renvoie que le
        premier nœud — deux tuiles partageant une clé laisseraient la seconde
        masquée jusqu'au rechargement suivant.
    -->
    <template id="portal_my_home_candidature" name="Portail : mes candidatures"
              customize_show="True" inherit_id="portal.portal_my_home"
              priority="80">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">OPEX Intervenants — mes candidatures</t>
                <t t-set="url" t-value="'/my/missions/candidatures'"/>
                <t t-set="text">Suivez vos candidatures aux appels à mission du cluster, de l'invitation à la sélection.</t>
                <t t-set="placeholder_count" t-value="'intervenants_candidature_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- Mes candidatures -->

    <template id="portal_my_candidatures" name="Mes candidatures">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Mes candidatures</h3>
                    <a class="btn btn-outline-primary" href="/missions">
                        Voir les appels ouverts
                    </a>
                </div>

                <div t-if="not applications" class="alert alert-light border">
                    Vous n'avez pas encore candidaté.
                    <a href="/missions">Parcourez les opportunités du cluster</a>.
                </div>

                <div t-if="applications" class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Appel</th><th>Mission</th><th>Origine</th>
                                <th>État</th><th/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="applications" t-as="a">
                                <td class="text-nowrap text-muted"
                                    t-out="a.mission_id.name"/>
                                <td t-out="a.mission_id.title"/>
                                <td>
                                    <span class="badge text-bg-light"
                                          t-out="dict(a._fields['source'].selection).get(a.source, '')"/>
                                </td>
                                <td>
                                    <!-- Le libellé utilisateur, jamais le code
                                         technique de l'étape. -->
                                    <span t-out="a.workflow_stage_label"/>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       t-attf-href="/my/missions/candidature/#{a.id}">
                                        Ouvrir
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <!--
        §9 — LA CANDIDATURE LEAN

        Le bloc « ce que nous savons déjà » n'est pas de la décoration : il
        est la **preuve à l'écran** que rien de permanent n'est redemandé. Le
        candidat voit son capital, en lecture, et ne remplit que ce qui est
        propre à cette mission.

        « Un expert référencé ne ressaisit pas son profil permanent pour
        candidater » — troisième critère d'acceptation du §21.
    -->
    <template id="portal_candidature" name="Ma candidature">
        <t t-call="portal.portal_layout">
            <div class="container my-4">

                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="text-muted small" t-out="mission['reference']"/>
                        <h3 class="mb-0" t-out="mission['titre']"/>
                        <div class="text-muted">
                            <t t-out="mission['type']"/> —
                            <t t-out="application.workflow_stage_label"/>
                        </div>
                    </div>
                    <a class="btn btn-light" href="/my/missions/candidatures">
                        Mes candidatures
                    </a>
                </div>

                <div t-if="error" class="alert alert-warning" t-out="error"/>

                <!-- Ce que nous savons déjà -->

                <div class="card mb-4">
                    <div class="card-header">
                        <strong>Ce que nous savons déjà de vous</strong>
                        <span class="text-muted small ms-2">
                            Repris de votre profil — rien à ressaisir.
                        </span>
                    </div>
                    <div class="card-body">
                        <div t-if="profil" class="row g-3">
                            <div class="col-6 col-lg-3">
                                <div class="text-muted small">Compétences</div>
                                <div class="fs-4" t-out="capital['competences']"/>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="text-muted small">Expériences</div>
                                <div class="fs-4" t-out="capital['experiences']"/>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="text-muted small">Certifications valides</div>
                                <div class="fs-4" t-out="capital['certifications_valides']"/>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="text-muted small">Réputation</div>
                                <div class="fs-4">
                                    <t t-if="capital['evaluations']">
                                        <t t-out="capital['reputation']"/> / 5
                                    </t>
                                    <span t-else="" class="text-muted">—</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <span t-foreach="profil.expert_skill_ids" t-as="s"
                                      class="badge text-bg-light me-1"
                                      t-out="s.competence_id.name"/>
                            </div>
                            <div class="col-12">
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="/my/missions/expertise">
                                    Compléter mon expertise
                                </a>
                            </div>
                        </div>
                        <p t-else="" class="text-muted mb-0">
                            Votre profil est en cours de création.
                        </p>
                    </div>
                </div>

                <!-- Ce qui est propre à cette mission -->

                <form method="post" t-if="modifiable"
                      t-attf-action="/my/missions/candidature/#{application.id}">
                    <input type="hidden" name="csrf_token"
                           t-att-value="request.csrf_token()"/>

                    <div class="card mb-3">
                        <div class="card-header">
                            <strong>Ce qui est propre à cette mission</strong>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="disponibilite">
                                        Disponibilité <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" name="disponibilite"
                                            id="disponibilite" required="required">
                                        <option value="">— Choisir —</option>
                                        <t t-foreach="application._fields['disponibilite'].selection"
                                           t-as="opt">
                                            <option t-att-value="opt[0]"
                                                    t-att-selected="'selected' if application.disponibilite == opt[0] else None"
                                                    t-out="opt[1]"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-8 mb-3">
                                    <label class="form-label"
                                           for="disponibilite_commentaire">
                                        Précision sur votre disponibilité
                                    </label>
                                    <input type="text" class="form-control"
                                           name="disponibilite_commentaire"
                                           id="disponibilite_commentaire"
                                           t-att-value="application.disponibilite_commentaire or ''"/>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="delai_propose_jours">
                                        Délai de mobilisation (jours)
                                    </label>
                                    <input type="number" min="0" class="form-control"
                                           name="delai_propose_jours"
                                           id="delai_propose_jours"
                                           t-att-value="application.delai_propose_jours or ''"/>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="type_tarif">
                                        Type de proposition
                                    </label>
                                    <select class="form-select" name="type_tarif"
                                            id="type_tarif">
                                        <option value="">— Choisir —</option>
                                        <t t-foreach="application._fields['type_tarif'].selection"
                                           t-as="opt">
                                            <option t-att-value="opt[0]"
                                                    t-att-selected="'selected' if application.type_tarif == opt[0] else None"
                                                    t-out="opt[1]"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="tarif_propose">
                                        Tarif proposé
                                    </label>
                                    <input type="text" class="form-control"
                                           name="tarif_propose" id="tarif_propose"
                                           t-att-value="application.tarif_propose or ''"/>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="motivation">
                                    Motivation
                                </label>
                                <textarea class="form-control" name="motivation"
                                          id="motivation" rows="3"
                                          placeholder="Pourquoi cette mission ?"
                                          t-out="application.motivation or ''"/>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="methodologie">
                                    Approche proposée
                                </label>
                                <textarea class="form-control" name="methodologie"
                                          id="methodologie" rows="4"
                                          placeholder="Comment comptez-vous procéder ?"
                                          t-out="application.methodologie or ''"/>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="consentement" id="consentement" value="1"
                                       t-att-checked="'checked' if application.consentement else None"/>
                                <label class="form-check-label" for="consentement">
                                    J'accepte les conditions de candidature et les
                                    règles de confidentialité du cluster.
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-4">
                        <button type="submit" name="action" value="save"
                                class="btn btn-light">
                            Enregistrer
                        </button>
                        <button type="submit" name="action" value="submit"
                                class="btn btn-primary">
                            Envoyer ma candidature
                        </button>
                    </div>
                </form>

                <!--
                     Les pièces propres à la mission

                    CV, portfolio, références et certifications **ne sont pas**
                    dans la liste. Ils vivent sur le profil et sont affichés
                    plus haut : les redemander serait la ressaisie que le §9
                    interdit. Ne restent que la proposition technique, la
                    proposition financière, et l'imprévu.
                -->
                <div class="card mb-4" t-if="modifiable">
                    <div class="card-header">
                        <strong>Pièces propres à cette mission</strong>
                        <span class="text-muted small ms-2">
                            Votre CV et vos certifications sont déjà sur votre
                            profil — inutile de les rejoindre.
                        </span>
                    </div>
                    <div class="card-body">
                        <div t-if="application.document_ids" class="table-responsive mb-3">
                            <table class="table table-sm align-middle mb-0">
                                <tbody>
                                    <tr t-foreach="application.document_ids" t-as="d">
                                        <td t-out="dict(types_pieces).get(d.document_type, d.document_type)"/>
                                        <td t-out="d.name"/>
                                        <td class="text-muted small" t-out="d.filename"/>
                                        <td class="text-end">
                                            <form method="post"
                                                  t-attf-action="/my/missions/candidature/#{application.id}">
                                                <input type="hidden" name="csrf_token"
                                                       t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="action"
                                                       value="remove_document"/>
                                                <input type="hidden" name="document_id"
                                                       t-att-value="d.id"/>
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Retirer
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <form method="post" enctype="multipart/form-data"
                              t-attf-action="/my/missions/candidature/#{application.id}"
                              class="row g-2 align-items-end">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="action" value="add_document"/>
                            <div class="col-md-4">
                                <label class="form-label" for="document_type">Type</label>
                                <select class="form-select" name="document_type"
                                        id="document_type">
                                    <t t-foreach="types_pieces" t-as="t">
                                        <option t-att-value="t[0]" t-out="t[1]"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="doc_name">Intitulé</label>
                                <input type="text" class="form-control" name="name"
                                       id="doc_name"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="doc_file">Fichier</label>
                                <input type="file" class="form-control" name="file"
                                       id="doc_file"/>
                            </div>
                            <div class="col-md-1">
                                <button type="submit"
                                        class="btn btn-outline-primary w-100">+</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Candidature déposée -->

                <div t-if="not modifiable" class="card">
                    <div class="card-body">
                        <h6>Votre candidature est déposée</h6>
                        <p class="text-muted mb-3">
                            Elle est à l'étape
                            « <t t-out="application.workflow_stage_label"/> ».
                            Vous ne pouvez plus la modifier : la version examinée
                            par le cluster doit être celle qu'il a lue.
                        </p>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Disponibilité</dt>
                            <dd class="col-sm-8">
                                <t t-out="dict(application._fields['disponibilite'].selection).get(application.disponibilite, '—')"/>
                            </dd>
                            <dt class="col-sm-4">Délai de mobilisation</dt>
                            <dd class="col-sm-8">
                                <t t-out="application.delai_propose_jours"/> jours
                            </dd>
                            <dt class="col-sm-4">Tarif proposé</dt>
                            <dd class="col-sm-8" t-out="application.tarif_propose"/>
                            <dt class="col-sm-4">Pièces jointes</dt>
                            <dd class="col-sm-8" t-out="len(application.document_ids)"/>
                        </dl>

                        <form method="post" class="mt-3"
                              t-attf-action="/my/missions/candidature/#{application.id}/retirer">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                Retirer ma candidature
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
