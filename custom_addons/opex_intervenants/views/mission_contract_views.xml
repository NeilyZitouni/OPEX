<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
         L'AFFECTATION — §15
          -->

    <record id="view_mission_assignment_form" model="ir.ui.view">
        <field name="name">opex.mission.assignment.form</field>
        <field name="model">opex.mission.assignment</field>
        <field name="arch" type="xml">
            <form string="Affectation">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="contract_count" widget="statinfo"
                                   string="Pièces"/>
                        </button>
                        <!-- REBRANCHEMENT `project` : la condition etait
                             invisible="not project_id". Le bouton depend
                             desormais aussi de la presence du module : sans
                             lui, `task_count` vaut toujours 0 et le bouton
                             n'ouvrirait rien. -->
                        <field name="project_disponible" invisible="1"/>
                        <field name="project_ref" invisible="1"/>
                        <button name="action_view_project" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="not project_disponible or not project_ref">
                            <field name="task_count" widget="statinfo"
                                   string="Tâches"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="partner_id" readonly="1"/></h1>
                        <h3><field name="mission_id" readonly="1"/></h3>
                    </div>

                    <group>
                        <group string="Origine">
                            <field name="application_id" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="expert_profile_id" readonly="1"/>
                            <field name="nda_required" readonly="1"/>
                        </group>
                        <group string="Conditions retenues">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="duree_jours"/>
                            <field name="type_tarif"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="tarif"/>
                            <field name="montant_total"/>
                        </group>
                    </group>

                    <group string="Exécution">
                        <!-- REBRANCHEMENT `project` : c'etait
                             <field name="project_id" readonly="1"/>.
                             Le libelle remplace la relation ; l'alerte dit
                             pourquoi la case est vide, ce qu'un champ vide
                             ne dit pas. -->
                        <field name="project_name" readonly="1"
                               invisible="not project_disponible"/>
                        <div class="alert alert-info" role="alert"
                             invisible="project_disponible">
                            Le module Projet n'est pas installé : aucun projet
                            d'exécution n'est créé au démarrage de la mission.
                            Le suivi se fait dans l'onglet Exécution de
                            l'appel — livrables, points d'avancement,
                            incidents.
                        </div>
                        <field name="active" invisible="1"/>
                    </group>

                    <notebook>
                        <page string="Pièces contractuelles" name="contrats">
                            <field name="contract_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="contract_type"/>
                                    <field name="version"/>
                                    <field name="current_version"/>
                                    <field name="montant"/>
                                    <field name="is_signed"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mission_assignment_list" model="ir.ui.view">
        <field name="name">opex.mission.assignment.list</field>
        <field name="model">opex.mission.assignment</field>
        <field name="arch" type="xml">
            <list string="Affectations">
                <field name="mission_id"/>
                <field name="partner_id"/>
                <field name="source"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="montant_total"/>
                <field name="contract_count" string="Pièces"/>
                <!-- REBRANCHEMENT `project` : c'etait project_id. -->
                <field name="project_name" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_mission_assignment" model="ir.actions.act_window">
        <field name="name">Affectations</field>
        <field name="res_model">opex.mission.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune affectation.</p>
            <p>
                Une affectation naît d'une candidature retenue : elle est créée
                par le déclencheur configuré sur « Retenir cette candidature »,
                jamais à la main.
            </p>
        </field>
    </record>

    <!--
         LA PIÈCE CONTRACTUELLE — §18, §19
          -->

    <record id="view_mission_contract_form" model="ir.ui.view">
        <field name="name">opex.mission.contract.form</field>
        <field name="model">opex.mission.contract</field>
        <field name="arch" type="xml">
            <form string="Pièce contractuelle">
                <header>
                    <!--
                        Signer consigne un fait ; ce sont deux boutons, et
                        aucun ne fait avancer le workflow. La transition
                        « Signatures recueillies » lit ces cases et reste au
                        responsable — sans quoi le modèle déciderait à sa
                        place, et la condition ne servirait à rien.
                    -->
                    <button name="action_sign_client" type="object"
                            string="Enregistrer la signature du client"
                            class="btn-secondary"
                            invisible="signature_client"/>
                    <button name="action_sign_intervenant" type="object"
                            string="Enregistrer la signature de l'intervenant"
                            class="btn-secondary"
                            invisible="signature_intervenant"/>
                    <button name="action_preview_html" type="object"
                            string="Aperçu" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="name" readonly="1" class="text-muted"/></h2>
                        <h1>
                            <field name="contract_type"/>
                            <span class="text-muted"> — version </span>
                            <field name="version" readonly="1"/>
                        </h1>
                    </div>

                    <!--
                        Le rappel du poste, pas une excuse : l'utilisateur
                        qui clique « Imprimer » recevra une erreur, et il vaut
                        mieux qu'il l'ait lue avant.
                    -->
                    <div class="alert alert-info" role="status">
                        Le bouton <strong>Aperçu</strong> ouvre le document dans
                        le navigateur. L'export PDF exige
                        <code>wkhtmltopdf</code>, absent de ce poste.
                    </div>

                    <group>
                        <group string="Rattachement">
                            <field name="assignment_id" readonly="1"/>
                            <field name="mission_id" readonly="1"/>
                            <field name="client_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="current_version"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Conditions">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="duree_jours"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="montant"/>
                        </group>
                    </group>

                    <group string="Signatures">
                        <group>
                            <field name="signature_client" readonly="1"/>
                            <field name="signature_client_nom" readonly="1"
                                   invisible="not signature_client"/>
                            <field name="signature_client_date" readonly="1"
                                   invisible="not signature_client"/>
                        </group>
                        <group>
                            <field name="signature_intervenant" readonly="1"/>
                            <field name="signature_intervenant_nom" readonly="1"
                                   invisible="not signature_intervenant"/>
                            <field name="signature_intervenant_date" readonly="1"
                                   invisible="not signature_intervenant"/>
                            <field name="is_signed" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Contenu" name="contenu">
                            <group>
                                <field name="objet" placeholder="Objet de la mission"/>
                                <field name="livrables"/>
                                <field name="conditions"/>
                                <field name="modalites_validation"/>
                            </group>
                        </page>
                        <page string="Pièce signée" name="fichier">
                            <group>
                                <field name="document" filename="document_filename"/>
                                <field name="document_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mission_contract_list" model="ir.ui.view">
        <field name="name">opex.mission.contract.list</field>
        <field name="model">opex.mission.contract</field>
        <field name="arch" type="xml">
            <list string="Pièces contractuelles">
                <field name="name"/>
                <field name="mission_id"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="version"/>
                <field name="current_version"/>
                <field name="montant"/>
                <field name="is_signed"/>
            </list>
        </field>
    </record>

    <record id="view_mission_contract_search" model="ir.ui.view">
        <field name="name">opex.mission.contract.search</field>
        <field name="model">opex.mission.contract</field>
        <field name="arch" type="xml">
            <!--
                Tous les `<field>` d'abord, puis les filtres, et un
                `<group name="group_by">` **nu** : une vue `search` refuse
                `expand` et `string` sur son `<group>`, la vue entière devient
                invalide et le module ne se charge plus. Payé à l'Extension 1 ;
                le message parle de RelaxNG et ne nomme pas l'attribut fautif.
            -->
            <search string="Pièces contractuelles">
                <field name="name"/>
                <field name="mission_id"/>
                <field name="partner_id"/>
                <filter name="en_vigueur" string="Version en vigueur"
                        domain="[('current_version', '=', True)]"/>
                <filter name="signe" string="Signées"
                        domain="[('signature_client', '=', True), ('signature_intervenant', '=', True)]"/>
                <filter name="a_signer" string="En attente de signature"
                        domain="['|', ('signature_client', '=', False), ('signature_intervenant', '=', False)]"/>
                <separator/>
                <filter name="contrats" string="Contrats"
                        domain="[('contract_type', '=', 'contrat')]"/>
                <filter name="ordres" string="Ordres de mission"
                        domain="[('contract_type', '=', 'ordre_mission')]"/>
                <filter name="ndas" string="NDA"
                        domain="[('contract_type', '=', 'nda')]"/>
                <group name="group_by">
                    <filter name="group_mission" string="Appel à mission"
                            context="{'group_by': 'mission_id'}"/>
                    <filter name="group_type" string="Nature"
                            context="{'group_by': 'contract_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mission_contract" model="ir.actions.act_window">
        <field name="name">Pièces contractuelles</field>
        <field name="res_model">opex.mission.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_en_vigueur': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune pièce contractuelle.</p>
            <p>
                Le contrat et l'ordre de mission sont générés automatiquement à
                la sélection d'un intervenant (§18). Le NDA n'est produit que
                si l'appel l'exige.
            </p>
        </field>
    </record>

    <!--
         GREFFE SUR LA FICHE DE L'APPEL
          -->

    <record id="view_mission_request_form_contracting" model="ir.ui.view">
        <field name="name">opex.mission.request.form.contracting</field>
        <field name="model">opex.mission.request</field>
        <field name="inherit_id" ref="view_mission_request_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_assignments" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="not assignment_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Affectation</span>
                    </div>
                </button>
            </xpath>

            <!--
                Un second bouton d'action, et il est nommé.

                Le bouton « Action » de l'en-tête fait avancer la **mission** :
                le mixin ne connaît que `workflow_instance_id`, l'instance
                principale. La contractualisation est une seconde instance sur
                le même enregistrement — elle a donc son propre accès, et un
                libellé qui dit lequel des deux processus on fait avancer.
            -->
            <xpath expr="//notebook" position="inside">
                <page string="Contractualisation" name="contractualisation"
                      invisible="not assignment_id">
                    <div class="alert alert-info" role="status"
                         invisible="not contract_stage_label">
                        Contractualisation :
                        <strong><field name="contract_stage_label" readonly="1"/></strong>
                    </div>
                    <button name="action_open_contract_workflow" type="object"
                            string="Faire avancer la contractualisation"
                            class="btn-primary mb-3"
                            invisible="not contract_stage_label"/>
                    <group>
                        <group string="Intervenant retenu">
                            <field name="assignment_id" readonly="1"/>
                            <field name="contract_id" readonly="1"/>
                        </group>
                        <group string="Faits contractuels">
                            <!--
                                Des faits, pas un avancement : le contrat
                                existe-t-il, est-il signé. L'étape, c'est
                                l'encart ci-dessus.
                            -->
                            <field name="contract_ready" readonly="1"/>
                            <field name="contract_fully_signed" readonly="1"/>
                            <field name="selected_application_count" readonly="1"/>
                            <field name="type_multi_intervenants" readonly="1"/>
                        </group>
                    </group>
                    <field name="assignment_ids" readonly="1">
                        <list>
                            <field name="partner_id"/>
                            <field name="source"/>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="montant_total"/>
                            <!-- REBRANCHEMENT `project` : c'etait project_id. -->
                            <field name="project_name"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!--
         MENUS
          -->

    <menuitem id="menu_mission_assignment"
              name="Affectations"
              parent="menu_intervenants_root"
              action="action_mission_assignment"
              sequence="40"
              groups="group_mission_manager,opex_membership.group_secretariat"/>

    <menuitem id="menu_mission_contract"
              name="Contrats et ordres de mission"
              parent="menu_intervenants_root"
              action="action_mission_contract"
              sequence="50"
              groups="group_mission_manager,opex_membership.group_secretariat"/>

</odoo>
