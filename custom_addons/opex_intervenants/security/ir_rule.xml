        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
        L'évaluation est la seule des cinq que l'intervenant **lit sans
        pouvoir l'écrire**, et l'ACL le dit déjà (`1,0,0,0`). C'est le §33 :
        « Selon les droits, certaines informations peuvent être visibles
        publiquement et d'autres rester confidentielles » — un intervenant qui
        pourrait corriger sa propre note viderait la réputation de son sens.
    -->
    <record id="rule_expert_rating_portal" model="ir.rule">
        <field name="name">Évaluation : l'intervenant lit les siennes, sans les modifier</field>
        <field name="model_id" ref="model_opex_expert_rating"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Le personnel des missions lit tout le capital : c'est ce qu'il compare
        au §16, et ce que le Smart Matching interrogera à l'Extension 4.
        Un employé ordinaire, lui, ne le lit pas — le CSV ne lui donne la
        lecture que sur `base.group_user`, et cette règle-ci ne l'élargit pas.
    -->
    <record id="rule_expert_capital_staff" model="ir.rule">
        <field name="name">Compétence : le personnel des missions lit tout</field>
        <field name="model_id" ref="model_opex_expert_skill"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
