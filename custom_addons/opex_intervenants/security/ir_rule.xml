        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mission_document_staff" model="ir.rule">
        <field name="name">Pièce de l'appel : le personnel des missions voit tout</field>
        <field name="model_id" ref="model_opex_mission_document"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_application_document_portal" model="ir.rule">
        <field name="name">Pièce de candidature : l'intervenant n'accède qu'aux siennes</field>
        <field name="model_id" ref="model_opex_mission_application_document"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('application_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_application_document_portal_write" model="ir.rule">
        <field name="name">Pièce de candidature : déposable tant que l'intervenant est attendu</field>
        <field name="model_id" ref="model_opex_mission_application_document"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('application_id.partner_id', '=', user.partner_id.id), ('application_id.workflow_stage_id.code', 'in', ['interested'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_application_document_internal" model="ir.rule">
        <field name="name">Pièce de candidature : les internes ne voient que les candidatures déposées</field>
        <field name="model_id" ref="model_opex_mission_application_document"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('application_id.workflow_stage_id.code', 'not in', ['invited', 'viewed', 'interested'])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_application_document_staff" model="ir.rule">
        <field name="name">Pièce de candidature : le personnel des missions voit tout</field>
        <field name="model_id" ref="model_opex_mission_application_document"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
