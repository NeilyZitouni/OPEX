    <!--
         EXTENSION 7 — AFFECTATION ET PIÈCES CONTRACTUELLES

         Deux parties concernées, et une seule règle portail pour chacun des
         deux modèles : le domaine nomme **les deux** côtés du contrat.

         En lecture seule pour le portail, et c'est délibéré. La signature
         est aujourd'hui enregistrée depuis le back-office, horodatée et
         nominative ; l'écran de signature portail relève de l'Extension 11.
         Ouvrir l'écriture avant que cet écran existe donnerait un droit que
         rien n'utilise et que rien ne borne à ce qu'il faut signer.
    -->

    <record id="rule_mission_assignment_portal" model="ir.rule">
        <field name="name">Affectation : le client et l'intervenant concernés</field>
        <field name="model_id" ref="model_opex_mission_assignment"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('mission_id.client_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

