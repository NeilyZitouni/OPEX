        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
         EXTENSION 3 — LE CAPITAL DE L'INTERVENANT

         Les cinq modèles suivent la même règle : **l'intervenant n'accède
         qu'au sien**, le personnel des missions lit tout.

         Le domaine s'appuie sur `partner_id`, un `related` **stocké** depuis
         `profile_id.partner_id`. Une `ir.rule` a besoin d'une colonne : sans
         le stockage, le domaine serait inexploitable et il faudrait traverser
         `profile_id.partner_id` à chaque ligne.

         Le personnel a le droit de **lire** ce capital, pas de l'écrire.
         C'est celui de l'intervenant : le cluster le consulte pour décider,
         il ne le corrige pas à sa place. Seul le gestionnaire peut intervenir,
         et c'est tracé par le chatter du profil.
    -->

    <record id="rule_expert_skill_portal" model="ir.rule">
        <field name="name">Compétence : l'intervenant n'accède qu'aux siennes</field>
        <field name="model_id" ref="model_opex_expert_skill"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_expert_experience_portal" model="ir.rule">
        <field name="name">Expérience : l'intervenant n'accède qu'aux siennes</field>
        <field name="model_id" ref="model_opex_expert_experience"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
