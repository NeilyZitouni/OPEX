<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Même principe que sur `opex.membership.file` du Module 1 et
        `opex.innovation.project` du Module 2 : les droits du CSV portent sur le
        **modèle**, ces règles portent sur l'**enregistrement**. Sans elles, un
        client portail lirait — et modifierait — les demandes de tous les autres.

        Le contrôle applicatif des controllers viendra aux Extensions 2 et 5 ;
        celui-ci est le second verrou, celui qui s'applique à toutes les
        requêtes, y compris celles qu'on n'a pas écrites.

        Les domaines s'appuient sur `workflow_stage_id.code`, c'est-à-dire sur
        **la configuration**, jamais sur un champ d'état du modèle métier. Le
        processus peut donc changer sans qu'une seule de ces règles bouge.
    -->

    <!--
         L'APPEL À MISSION
          -->

    <record id="rule_mission_request_portal" model="ir.rule">
        <field name="name">Appel à mission : le client n'accède qu'aux siens</field>
        <field name="model_id" ref="model_opex_mission_request"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('client_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Écriture bornée à l'étape où le client est réellement attendu : son
        brouillon, et lui seul.

        La boucle du Schéma 3 — « Informations manquantes → retour au client » —
        renvoie le dossier en `draft` plutôt que dans une étape dédiée, et c'est
        précisément ce qui lui rend le droit d'écrire. Une fois la demande
        soumise, il ne la réécrit plus sous le secrétariat.
    -->
    <record id="rule_mission_request_portal_write" model="ir.rule">
        <field name="name">Appel à mission : modifiable tant que le client est attendu</field>
        <field name="model_id" ref="model_opex_mission_request"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('client_id', '=', user.partner_id.id), ('workflow_stage_id.code', 'in', ['draft'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Le brouillon d'un client n'appartient qu'à lui : un employé ordinaire
        n'a pas à lire une demande qui n'a pas encore été soumise.

        Rappel de sémantique Odoo : les règles portées par les différents
        groupes d'un même utilisateur sont **unies** (OR), pas intersectées. Le
        responsable de mission, qui est aussi `base.group_user`, retrouve donc
        l'accès complet par sa propre règle ci-dessous — celle des employés ne
        le lui retire pas.
    -->
    <record id="rule_mission_request_internal" model="ir.rule">
        <field name="name">Appel à mission : les internes ne voient pas les brouillons</field>
        <field name="model_id" ref="model_opex_mission_request"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('workflow_stage_id.code', '!=', 'draft')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mission_request_staff" model="ir.rule">
        <field name="name">Appel à mission : le personnel des missions voit tout</field>
        <field name="model_id" ref="model_opex_mission_request"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
         LA CANDIDATURE
          -->

    <!--
        §14 : « L'intervenant peut consulter uniquement l'état de sa propre
        candidature selon les règles de confidentialité. » Il ne voit donc pas
        les candidatures concurrentes, et c'est ce qui rend la comparaison du
        §16 défendable.
    -->
    <record id="rule_mission_application_portal" model="ir.rule">
        <field name="name">Candidature : l'intervenant n'accède qu'aux siennes</field>
        <field name="model_id" ref="model_opex_mission_application"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        `interested` est la seule étape où l'intervenant remplit quoi que ce
        soit : c'est là que se saisit la candidature Lean du §9. Une fois
        déposée, il ne la réécrit plus sous le responsable — la version examinée
        doit être celle qui a été lue.
    -->
    <record id="rule_mission_application_portal_write" model="ir.rule">
        <field name="name">Candidature : modifiable tant que l'intervenant est attendu</field>
        <field name="model_id" ref="model_opex_mission_application"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('workflow_stage_id.code', 'in', ['interested'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Une candidature qui n'a pas encore été déposée — `invited`, `viewed`,
        `interested` — n'est pas une candidature reçue : c'est une intention.
        Le §15 parle des « candidatures reçues », et un employé ordinaire n'a
        pas à lire un brouillon d'intervenant.

        Le personnel des missions, lui, doit les voir : le §19 de la
        spécification prévoit la « relance des experts invités n'ayant pas
        répondu », qui suppose de les avoir sous les yeux. C'est la règle
        suivante qui la lui donne.
    -->
    <record id="rule_mission_application_internal" model="ir.rule">
        <field name="name">Candidature : les internes ne voient pas les candidatures non déposées</field>
        <field name="model_id" ref="model_opex_mission_application"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('workflow_stage_id.code', 'not in', ['invited', 'viewed', 'interested'])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mission_application_staff" model="ir.rule">
        <field name="name">Candidature : le personnel des missions voit tout</field>
        <field name="model_id" ref="model_opex_mission_application"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
         LES PIÈCES JOINTES
          -->

    <record id="rule_mission_document_portal" model="ir.rule">
        <field name="name">Pièce de l'appel : limitée aux appels du client</field>
        <field name="model_id" ref="model_opex_mission_document"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('mission_id.client_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Déposées et retirées tant que la demande est au brouillon, comme la
         demande elle-même. Une pièce qu'on peut remplacer après soumission
