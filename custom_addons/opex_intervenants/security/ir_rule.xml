    <record id="rule_mission_document_portal_write" model="ir.rule">
        <field name="name">Pièce de l'appel : déposable tant que le client est attendu</field>
        <field name="model_id" ref="model_opex_mission_document"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('mission_id.client_id', '=', user.partner_id.id), ('mission_id.workflow_stage_id.code', 'in', ['draft'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_mission_document_internal" model="ir.rule">
        <field name="name">Pièce de l'appel : les internes ne voient pas celles des brouillons</field>
        <field name="model_id" ref="model_opex_mission_document"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
