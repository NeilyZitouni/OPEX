    <!--
         EXTENSION 8 — L'EXÉCUTION

         Deux parties portail concernées, et pas de la même façon :
         l'**intervenant** produit, le **client** suit (§21). Le domaine
         nomme les deux, les droits d'écriture ne concernent que le premier.
    -->

    <record id="rule_mission_deliverable_portal" model="ir.rule">
        <field name="name">Livrable : l'intervenant qui le produit, le client qui le suit</field>
        <field name="model_id" ref="model_opex_mission_deliverable"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('mission_id.client_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        L'écriture est bornée aux deux étapes où l'intervenant est réellement
        attendu, et au seul intervenant — le client, lui, ne dépose rien.

        Le motif est celui des Extensions 2 et 5 : une fois le livrable soumis,
        il ne le réécrit plus sous le valideur. La version examinée doit être
        celle qui a été lue, et c'est aussi ce qui donne son sens à l'archive
        du §25 — un fichier qu'on peut remplacer après coup rendrait
        l'historique des versions décoratif.
    -->
    <record id="rule_mission_deliverable_portal_write" model="ir.rule">
        <field name="name">Livrable : modifiable tant que l'intervenant est attendu</field>
        <field name="model_id" ref="model_opex_mission_deliverable"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('workflow_stage_id.code', 'in', ['todo', 'in_progress', 'correction_requested'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mission_deliverable_staff" model="ir.rule">
        <field name="name">Livrable : le personnel des missions voit tout</field>
        <field name="model_id" ref="model_opex_mission_deliverable"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_deliverable_version_portal" model="ir.rule">
        <field name="name">Version : celles des livrables auxquels on a accès</field>
        <field name="model_id" ref="model_opex_mission_deliverable_version"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('deliverable_id.partner_id', '=', user.partner_id.id), ('deliverable_id.mission_id.client_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_deliverable_version_staff" model="ir.rule">
        <field name="name">Version : le personnel des missions lit tout</field>
        <field name="model_id" ref="model_opex_mission_deliverable_version"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Le point d'avancement : l'intervenant l'écrit, le client et le
        responsable le lisent (§21). L'écriture n'est pas bornée à une étape —
        un point d'avancement se rédige tant que la mission tourne — mais elle
        est bornée à **son auteur** : personne ne réécrit le compte rendu d'un
        autre, sinon la série de dates ne veut plus rien dire.
    -->
    <record id="rule_progress_report_portal" model="ir.rule">
        <field name="name">Point d'avancement : l'auteur et le client de la mission</field>
        <field name="model_id" ref="model_opex_mission_progress_report"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('mission_id.client_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_progress_report_portal_write" model="ir.rule">
        <field name="name">Point d'avancement : chacun le sien</field>
        <field name="model_id" ref="model_opex_mission_progress_report"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_progress_report_staff" model="ir.rule">
        <field name="name">Point d'avancement : le personnel des missions voit tout</field>
        <field name="model_id" ref="model_opex_mission_progress_report"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        L'incident est en **lecture seule** pour le portail, et seulement
        celui de sa propre mission.

        Le §26 est explicite : « Pendant une mission, **le responsable** peut
        signaler : retard, blocage… ». Ce n'est pas un canal de réclamation
        ouvert. L'intervenant signale ses difficultés dans le champ
        « Problèmes rencontrés » de son point d'avancement, et c'est le
        responsable qui décide d'en faire un incident.
    -->
    <record id="rule_mission_incident_portal" model="ir.rule">
        <field name="name">Incident : ceux de sa propre mission, en lecture</field>
        <field name="model_id" ref="model_opex_mission_incident"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('mission_id.client_id', '=', user.partner_id.id), ('mission_id.assignment_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mission_incident_staff" model="ir.rule">
        <field name="name">Incident : le personnel des missions voit tout</field>
        <field name="model_id" ref="model_opex_mission_incident"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
         EXTENSION 9 — LE CONSTAT DE SERVICE FAIT

         Les deux parties portail y figurent, et pour des raisons différentes :
         le **client** parce qu'il prononce la validation finale (§28), et
         l'**intervenant** parce que ce constat conditionne son paiement — il
         doit pouvoir voir où il en est sans avoir à le demander.

         En **lecture seule** pour les deux, et c'est le même arbitrage qu'à
         l'Extension 7 sur la signature du contrat : la validation du client est
         aujourd'hui enregistrée depuis le back-office, horodatée et nominative
         par le journal du moteur ; l'écran portail relève de l'Extension 11.
         Ouvrir l'écriture avant que cet écran existe donnerait un droit que
         rien n'utilise et que rien ne borne — un client pourrait cocher
         lui-même les quatre points du §28, qui sont ceux du cluster.
    -->

    <record id="rule_service_acceptance_portal" model="ir.rule">
        <field name="name">Service fait : le client qui valide, l'intervenant qui attend son paiement</field>
        <field name="model_id" ref="model_opex_service_acceptance"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('mission_id.client_id', '=', user.partner_id.id), ('assignment_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_service_acceptance_staff" model="ir.rule">
        <field name="name">Service fait : le personnel des missions voit tout</field>
        <field name="model_id" ref="model_opex_service_acceptance"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        EXTENSION 10 - LES ÉVALUATIONS

        Le §33 demande une visibilité contrôlée, et elle ne se règle pas de la
        même façon pour les deux parties portail.

        Le client accède aux évaluations qu'il rend, et à celles-là seules : la
        grille opérationnelle du cluster juge aussi le respect des procédures
        internes, ce qui ne le regarde pas.

        L'intervenant accède aux évaluations qui le concernent une fois
        qu'elles sont validées, les deux sources confondues. Une note qui
        alimente sa réputation doit lui être connue ; la délibération qui y
        mène, non. C'est la ligne entre ce qui est décidé et ce qui est en
        cours de discussion.
    -->

    <record id="rule_mission_evaluation_portal" model="ir.rule">
        <field name="name">Évaluation : celles qu'on rend, celles qui nous notent une fois validées</field>
        <field name="model_id" ref="model_opex_mission_evaluation"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', '&amp;', ('partner_id', '=', user.partner_id.id), ('workflow_stage_id.code', '=', 'validated'), '&amp;', ('mission_id.client_id', '=', user.partner_id.id), ('evaluateur', '=', 'client')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        L'écriture est bornée à l'auteur et aux deux étapes où il est attendu.
        Une fois la grille rendue, il ne la réécrit plus sous le valideur : la
        note examinée doit être celle qui a été lue, et c'est aussi ce qui
        donne son sens au renvoi pour complément.
    -->
    <record id="rule_mission_evaluation_portal_write" model="ir.rule">
        <field name="name">Évaluation : modifiable par son auteur tant qu'elle n'est pas rendue</field>
        <field name="model_id" ref="model_opex_mission_evaluation"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('mission_id.client_id', '=', user.partner_id.id), ('evaluateur', '=', 'client'), ('workflow_stage_id.code', 'in', ['pending', 'returned'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mission_evaluation_staff" model="ir.rule">
        <field name="name">Évaluation : le personnel des missions voit tout</field>
        <field name="model_id" ref="model_opex_mission_evaluation"/>
        <field name="groups" eval="[Command.link(ref('group_mission_manager')),
                                    Command.link(ref('group_mission_committee')),
                                    Command.link(ref('opex_membership.group_secretariat'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
