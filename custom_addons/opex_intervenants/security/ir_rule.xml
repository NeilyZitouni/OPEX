        <field name="model_id" ref="model_opex_expert_certification"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_expert_availability_portal" model="ir.rule">
        <field name="name">Disponibilité : l'intervenant n'accède qu'aux siennes</field>
        <field name="model_id" ref="model_opex_expert_availability"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
