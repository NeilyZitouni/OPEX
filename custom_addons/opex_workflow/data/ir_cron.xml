<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Contrôle quotidien des délais. Une fois par jour suffit : un SLA
            s'exprime en jours, le vérifier toutes les heures produirait la
            même information vingt-quatre fois.

            `noupdate="1"` : un administrateur qui change la fréquence ou
            désactive le cron ne doit pas voir son réglage écrasé à la
            prochaine mise à jour du module.
        -->
        <record id="cron_workflow_sla" model="ir.cron">
            <field name="name">Smart Workflow : contrôle des délais</field>
            <field name="model_id" ref="model_opex_workflow_instance"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_sla()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
