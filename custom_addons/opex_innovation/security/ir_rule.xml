        <field name="name">Accompagnement : le porteur ne voit que le sien</field>
        <field name="model_id" ref="model_opex_innovation_accompagnement"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('project_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_roadmap_phase_portal" model="ir.rule">
        <field name="name">Roadmap : limitée à l'accompagnement du porteur</field>
        <field name="model_id" ref="model_opex_innovation_roadmap_phase"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('accompagnement_id.project_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Le livrable est lisible par son porteur **et** par l'expert qui doit le
        valider — ce dernier par sa ligne d'acteur sur l'instance, pas par un
        champ du livrable. Être expert du cluster ne donne accès à rien ; c'est
        la désignation sur CE livrable qui ouvre la porte.
    -->
    <record id="rule_deliverable_portal" model="ir.rule">
        <field name="name">Livrable : son porteur, ou l'expert désigné dessus</field>
        <field name="model_id" ref="model_opex_innovation_deliverable"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('accompagnement_id.project_id.partner_id', '=', user.partner_id.id), ('workflow_instance_id.actor_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Le porteur dépose son fichier tant que le livrable l'attend. Une fois
         déposé, il ne le réécrit plus sous le contrôleur : la version en cours
         d'examen doit être celle que l'expert a lue. -->
    <record id="rule_deliverable_portal_write" model="ir.rule">
        <field name="name">Livrable : déposable tant que le porteur est attendu</field>
        <field name="model_id" ref="model_opex_innovation_deliverable"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('accompagnement_id.project_id.partner_id', '=', user.partner_id.id), ('workflow_stage_id.code', 'in', ['todo', 'correction_requested'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_deliverable_version_portal" model="ir.rule">
        <field name="name">Version de livrable : suit la visibilité du livrable</field>
        <field name="model_id" ref="model_opex_innovation_deliverable_version"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('deliverable_id.accompagnement_id.project_id.partner_id', '=', user.partner_id.id), ('deliverable_id.workflow_instance_id.actor_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_final_evaluation_cluster" model="ir.rule">
        <field name="name">Évaluation finale : le cluster voit tout</field>
