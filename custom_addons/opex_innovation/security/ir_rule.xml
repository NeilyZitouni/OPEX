    <!--
        ═══════════════════════════════════════════════════════════════
        ⚠ CONFIDENTIALITÉ DES AVIS — schéma 7
        ═══════════════════════════════════════════════════════════════

        « Chaque évaluateur travaille indépendamment. Il ne peut pas consulter
        les avis ou les scores des autres évaluateurs avant la finalisation de
        son propre avis. »

        Cette règle est le **plancher de la base** : chacun voit le sien, plus
        ceux qui ont déjà été rendus. Les écrans, eux, appliquent la règle
        complète via `project.visible_evaluations()` — qui exige en plus que
        l'évaluateur ait finalisé son propre avis.

        L'écart est assumé et documenté : un domaine `ir.rule` ne sait pas
        exprimer « à condition que mon propre avis soit rendu » sans champ
        calculé stocké. La barrière forte est donc applicative, celle-ci borne
        la base pour tout accès qu'on n'aurait pas prévu.
    -->
    <record id="rule_evaluation_evaluator" model="ir.rule">
        <field name="name">Avis : le sien, plus ceux déjà rendus</field>
        <field name="model_id" ref="model_opex_innovation_evaluation"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('evaluator_id', '=', user.partner_id.id), ('state', '=', 'submitted')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- L'évaluateur ne modifie que le sien, et seulement tant qu'il ne l'a
         pas rendu. Un avis figé est ce qui donne un sens à l'indépendance. -->
    <record id="rule_evaluation_evaluator_write" model="ir.rule">
        <field name="name">Avis : modifiable par son auteur tant qu'il n'est pas rendu</field>
        <field name="model_id" ref="model_opex_innovation_evaluation"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('evaluator_id', '=', user.partner_id.id), ('state', '!=', 'submitted')]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Utilisateurs internes non habilités : même cloisonnement. Sans cette
         règle, tout employé lirait les avis de tous les évaluateurs. -->
    <record id="rule_evaluation_internal" model="ir.rule">
        <field name="name">Avis : cloisonnement des utilisateurs internes</field>
        <field name="model_id" ref="model_opex_innovation_evaluation"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('evaluator_id', '=', user.partner_id.id), ('state', '=', 'submitted')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_evaluation_committee" model="ir.rule">
