    <!--
        ═══════════════════════════════════════════════════════════════
        Extension 18 — section 32, ce qui manquait
        ═══════════════════════════════════════════════════════════════

        Le tableau de la section 32 nomme cinq acteurs. Un employé ordinaire
        n'en fait pas partie — or il n'existait **aucune** `ir.rule` sur
        `opex.innovation.project` pour les groupes internes. Tout utilisateur
        interne lisait donc l'intégralité des projets, brouillons compris, et
        pouvait les écrire (`perm_write` valait 1 dans le CSV, ramené à 0).

        Le brouillon d'un porteur n'appartient qu'à lui : la section 32 dit que
        le secrétariat voit les « projets soumis », pas les dossiers en cours de
        rédaction. Le domaine s'appuie sur `workflow_stage_id.code`, donc sur la
        configuration : le processus peut changer sans que cette règle bouge.

        ⚠ Rappel de sémantique Odoo : les règles portées par les différents
        groupes d'un même utilisateur sont **unies** (OR), pas intersectées. Un
        gestionnaire Innovation, qui est aussi `base.group_user`, retrouve donc
        l'accès complet par sa propre règle ci-dessous — il ne se le voit pas
        retirer par celle des employés.
    -->
    <record id="rule_project_internal" model="ir.rule">
        <field name="name">Projet : les internes ne voient pas les brouillons</field>
        <field name="model_id" ref="model_opex_innovation_project"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('workflow_stage_id.code', '!=', 'draft')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_project_manager" model="ir.rule">
        <field name="name">Projet : le gestionnaire Innovation voit tout</field>
        <field name="model_id" ref="model_opex_innovation_project"/>
        <field name="groups" eval="[Command.link(ref('group_innovation_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Même cloisonnement pour les pièces jointes : sans lui, un employé
         lisait le business plan de tous les brouillons. -->
    <record id="rule_project_document_internal" model="ir.rule">
        <field name="name">Pièce jointe : les internes ne voient pas celles des brouillons</field>
