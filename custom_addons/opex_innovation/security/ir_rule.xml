<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Même principe que sur `opex.membership.file` du Module 1 : les droits du
        CSV portent sur le modèle, pas sur l'enregistrement. Sans ces règles, un
        membre portail lirait — et modifierait — les demandes de tous les
        autres.

        Le contrôle applicatif du controller existe déjà ; celui-ci est le
        second verrou, celui qui porte sur toutes les requêtes, y compris celles
        qu'on n'a pas écrites.
    -->

    <record id="rule_expert_profile_portal" model="ir.rule">
        <field name="name">Profil expert : le membre n'accède qu'au sien</field>
        <field name="model_id" ref="model_opex_innovation_expert_profile"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Écriture restreinte aux étapes où le membre est réellement attendu :
        son brouillon, et le retour après demande de complément. Une fois la
        demande soumise, il ne peut plus la réécrire sous le contrôleur.

        Le domaine s'appuie sur `workflow_stage_id.code` — c'est-à-dire sur la
        configuration, pas sur un champ d'état du modèle métier. Le processus
        peut donc changer sans que cette règle bouge.
    -->
    <record id="rule_expert_profile_portal_write" model="ir.rule">
        <field name="name">Profil expert : modifiable tant que le membre est attendu</field>
        <field name="model_id" ref="model_opex_innovation_expert_profile"/>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('workflow_stage_id.code', 'in', ['draft', 'complement_requested'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_investor_profile_portal" model="ir.rule">
