<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_remediation_form" model="ir.ui.view">
        <field name="name">opex.innovation.remediation.form</field>
        <field name="model">opex.innovation.remediation</field>
        <field name="arch" type="xml">
            <form string="Remédiation">
                <header>
                    <button name="action_resolve" type="object" string="Marquer traitée"
                            invisible="resolved"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Le cluster ne dit pas « améliorez votre projet » : il
                        précise <strong>quoi</strong> corriger. Au moins un point
                        est exigé.
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="version" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_demande" readonly="1"/>
                            <field name="resolved" readonly="1"/>
                            <field name="date_resolved" readonly="1"
                                   invisible="not resolved"/>
                        </group>
                    </group>
                    <separator string="Points à corriger"/>
                    <field name="point_ids" widget="many2many_checkboxes"/>
                    <separator string="Commentaire du comité"/>
                    <field name="commentaire_comite" nolabel="1"/>
                    <separator string="Réponse du porteur" invisible="not reponse_porteur"/>
                    <field name="reponse_porteur" nolabel="1" readonly="1"
                           invisible="not reponse_porteur"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_remediation_list" model="ir.ui.view">
        <field name="name">opex.innovation.remediation.list</field>
        <field name="model">opex.innovation.remediation</field>
        <field name="arch" type="xml">
            <list string="Remédiations">
                <field name="project_id"/>
                <field name="version"/>
                <field name="point_ids" widget="many2many_tags"/>
                <field name="date_demande"/>
                <field name="resolved" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_remediation" model="ir.actions.act_window">
        <field name="name">Remédiations</field>
        <field name="res_model">opex.innovation.remediation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_remediation_point_list" model="ir.ui.view">
        <field name="name">opex.innovation.remediation.point.list</field>
        <field name="model">opex.innovation.remediation.point</field>
        <field name="arch" type="xml">
            <list string="Points de remédiation" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_remediation_point" model="ir.actions.act_window">
        <field name="name">Points de remédiation</field>
        <field name="res_model">opex.innovation.remediation.point</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_project_version_form" model="ir.ui.view">
        <field name="name">opex.innovation.project.version.form</field>
        <field name="model">opex.innovation.project.version</field>
        <field name="arch" type="xml">
            <form string="Version du dossier" create="false" edit="false">
                <sheet>
                    <div class="alert alert-light" role="status">
                        Archive figée du dossier à cette version. Elle ne suit
                        pas les modifications ultérieures du projet — c'est tout
                        son intérêt.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3>Version <field name="version" readonly="1" class="oe_inline"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="date_snapshot" readonly="1"/>
                        </group>
                        <group>
                            <field name="remediation_id" readonly="1"/>
                            <field name="score" readonly="1"/>
                            <field name="maturite" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="resume" readonly="1"/>
                        <field name="probleme" readonly="1"/>
                        <field name="solution" readonly="1"/>
                        <field name="marche_cible" readonly="1"/>
                        <field name="proposition_valeur" readonly="1"/>
                        <field name="modele_economique" readonly="1"/>
                        <field name="document_summary" readonly="1"/>
                        <field name="reponse_porteur" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_version_list" model="ir.ui.view">
        <field name="name">opex.innovation.project.version.list</field>
        <field name="model">opex.innovation.project.version</field>
        <field name="arch" type="xml">
            <list string="Versions" create="false">
                <field name="version"/>
                <field name="date_snapshot"/>
                <field name="score"/>
                <field name="remediation_id"/>
            </list>
        </field>
    </record>

    <!-- Onglets Remédiations et Versions sur le projet -->
    <record id="view_innovation_project_form_remediation" model="ir.ui.view">
        <field name="name">opex.innovation.project.form.remediation</field>
        <field name="model">opex.innovation.project</field>
        <field name="inherit_id" ref="view_innovation_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Remédiations" name="remediations">
                    <field name="remediation_ids" readonly="1">
                        <list create="false">
                            <field name="version"/>
                            <field name="point_ids" widget="many2many_tags"/>
                            <field name="commentaire_comite"/>
                            <field name="date_demande"/>
                            <field name="resolved" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
                <page string="Versions" name="versions">
                    <div class="alert alert-light" role="status">
                        Chaque resoumission fige le dossier tel qu'il était.
                        Les versions précédentes restent consultables.
                    </div>
                    <field name="current_version" readonly="1"/>
                    <field name="version_ids" readonly="1">
                        <list create="false">
                            <field name="version"/>
                            <field name="date_snapshot"/>
                            <field name="score"/>
                            <field name="remediation_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
