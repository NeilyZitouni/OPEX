<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_investor_profile_form" model="ir.ui.view">
        <field name="name">opex.innovation.investor.profile.form</field>
        <field name="model">opex.innovation.investor.profile</field>
        <field name="arch" type="xml">
            <form string="Profil Investisseur">
                <header>
                    <button name="action_workflow_transition" type="object"
                            string="Action" class="btn-primary"
                            invisible="workflow_state != 'running'"/>
                    <field name="workflow_definition_id" invisible="1"/>
                    <field name="workflow_state" invisible="1"/>
                    <field name="workflow_stage_id" widget="statusbar"
                           options="{'clickable': false}"
                           domain="[('definition_id', '=', workflow_definition_id)]"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id" readonly="1"/></h1>
                        <h3><field name="workflow_stage_label" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Profil">
                            <field name="type_investisseur"/>
                            <field name="stade_maturite_recherche"/>
                            <field name="zone_geographique"/>
                            <field name="secteur_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Ticket">
                            <field name="currency_id" invisible="1"/>
                            <field name="montant_min"/>
                            <field name="montant_max"/>
                            <field name="profile_activated" readonly="1"/>
                            <field name="motif_complement" readonly="1"
                                   invisible="not motif_complement"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stratégie" name="strategie">
                            <group>
                                <field name="domaines_investissement"/>
                                <field name="types_projets_recherches"/>
                                <field name="experience_investissement"/>
                                <field name="preferences"/>
                                <field name="presentation"/>
                            </group>
                        </page>
                        <page string="Justificatifs" name="documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="file" filename="filename"/>
                                    <field name="filename" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_investor_profile_list" model="ir.ui.view">
        <field name="name">opex.innovation.investor.profile.list</field>
        <field name="model">opex.innovation.investor.profile</field>
        <field name="arch" type="xml">
            <list string="Profils Investisseur">
                <field name="partner_id"/>
                <field name="type_investisseur"/>
                <field name="zone_geographique"/>
                <field name="workflow_stage_id"/>
                <field name="profile_activated" widget="boolean_toggle"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_investor_profile" model="ir.actions.act_window">
        <field name="name">Profils Investisseur</field>
        <field name="res_model">opex.innovation.investor.profile</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
