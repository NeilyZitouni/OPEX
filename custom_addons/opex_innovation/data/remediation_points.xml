<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Les points de la section 18, semés comme référentiel.

            « Le cluster ne doit pas simplement dire *Améliorez votre projet*.
            Il doit préciser ce qui doit être corrigé. » Cette liste est ce que
            le comité coche ; elle est paramétrable, un administrateur peut en
            ajouter sans développement.
        -->

        <record id="remediation_point_etude_marche" model="opex.innovation.remediation.point">
            <field name="name">Améliorer l'étude de marché</field>
            <field name="code">etude_marche</field>
            <field name="sequence">10</field>
            <field name="description">Préciser la taille du marché, les segments visés et les sources.</field>
        </record>

        <record id="remediation_point_modele_economique" model="opex.innovation.remediation.point">
            <field name="name">Détailler le modèle économique</field>
            <field name="code">modele_economique</field>
            <field name="sequence">20</field>
            <field name="description">Comment le projet gagne de l'argent, et sur quelle base de calcul.</field>
        </record>

        <record id="remediation_point_preuve_concept" model="opex.innovation.remediation.point">
            <field name="name">Ajouter une preuve de concept</field>
            <field name="code">preuve_concept</field>
            <field name="sequence">30</field>
            <field name="description">Un élément tangible montrant que la solution fonctionne.</field>
        </record>

        <record id="remediation_point_besoin_financement" model="opex.innovation.remediation.point">
            <field name="name">Préciser le besoin de financement</field>
            <field name="code">besoin_financement</field>
            <field name="sequence">40</field>
            <field name="description">Montant, usage prévu, échéancier.</field>
        </record>

        <record id="remediation_point_probleme_besoin" model="opex.innovation.remediation.point">
            <field name="name">Clarifier le problème ou le besoin</field>
            <field name="code">probleme_besoin</field>
            <field name="sequence">50</field>
            <field name="description">Quel problème est résolu, et pour qui.</field>
        </record>

        <record id="remediation_point_solution" model="opex.innovation.remediation.point">
            <field name="name">Approfondir la solution</field>
            <field name="code">solution</field>
            <field name="sequence">60</field>
            <field name="description">Ce que fait la solution, concrètement.</field>
        </record>

        <record id="remediation_point_prototype" model="opex.innovation.remediation.point">
            <field name="name">Fournir un prototype</field>
            <field name="code">prototype</field>
            <field name="sequence">70</field>
            <field name="description">Maquette, MVP, ou démonstration.</field>
        </record>

        <record id="remediation_point_faisabilite" model="opex.innovation.remediation.point">
            <field name="name">Démontrer la faisabilité</field>
            <field name="code">faisabilite</field>
            <field name="sequence">80</field>
            <field name="description">Technique, réglementaire et opérationnelle.</field>
        </record>

        <record id="remediation_point_equipe" model="opex.innovation.remediation.point">
            <field name="name">Renforcer l'équipe</field>
            <field name="code">equipe</field>
            <field name="sequence">90</field>
            <field name="description">Compétences manquantes au regard du projet.</field>
        </record>

        <record id="remediation_point_marche" model="opex.innovation.remediation.point">
            <field name="name">Préciser le positionnement marché</field>
            <field name="code">marche</field>
            <field name="sequence">100</field>
            <field name="description">Concurrence, différenciation, canal de vente.</field>
        </record>

    </data>
</odoo>
