<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            LES 14 NOTIFICATIONS DE LA SECTION 30

            « Chacun est une action `notify` configurée sur une transition, pas
            un `message_post()` dispersé dans le code métier. C'est la
            différence entre un module maintenable et un module où il faut
            chercher à quinze endroits pourquoi un email part. »

            Ce fichier **est** ces quinze endroits, réduits à un. Pour savoir
            pourquoi un message part, on lit ce fichier, et rien d'autre.

            **Sous-type.** `note` pour tout ce qui est interne, `comment`
            uniquement pour ce que le porteur ou le candidat doit réellement
            recevoir par email. Un message de coordination interne posté en
            `comment` sur un enregistrement que le porteur suit lui part par
            courriel — bug déjà rencontré et corrigé sur le Module 1.

            **Pas de SMS.** Décision reprise du Module 1. Aucun canal autre
            que le portail et le courriel n'est configuré, et il n'y a rien à
            désactiver : le moteur n'en connaît pas d'autre.

            Les destinataires ne sont jamais des personnes nommées : ce sont
            des **rôles**, résolus sur `instance.actor` — « le porteur de
            CE dossier », « le comité de CE dossier ». Un rôle sans acteur ne
            notifie personne, et c'est le comportement voulu.
        -->

        <!-- 1. Projet soumis -->
        <record id="notify_projet_soumis" model="opex.workflow.action">
            <field name="name">1. Projet soumis</field>
            <field name="code">innovation_notify_projet_soumis</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">note</field>
            <field name="body" type="html"><p>Un nouveau projet a été soumis et attend le contrôle administratif.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_secretariat')])]"/>
        </record>

        <!-- 2. Complément demandé -->
        <record id="notify_complement_demande" model="opex.workflow.action">
            <field name="name">2. Complément demandé</field>
            <field name="code">innovation_notify_complement_demande</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Action requise sur votre projet : des informations complémentaires vous sont demandées. Consultez votre espace personnel pour savoir lesquelles.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <!-- 3. Projet qualifié -->
        <record id="notify_projet_qualifie" model="opex.workflow.action">
            <field name="name">3. Projet qualifié</field>
            <field name="code">innovation_notify_projet_qualifie</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Votre projet a passé le contrôle administratif et entre en phase d'évaluation.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <!-- 4. Projet évalué -->
        <record id="notify_projet_evalue" model="opex.workflow.action">
            <field name="name">4. Projet évalué</field>
            <field name="code">innovation_notify_projet_evalue</field>
            <field name="action_type">notify</field>
            <!-- Interne : le porteur n'apprend pas qu'il est évalué, il
                 apprend la décision. -->
            <field name="notify_subtype">note</field>
            <field name="body" type="html"><p>Un projet attend l'évaluation du comité.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_comite')])]"/>
        </record>

        <!-- 5. Décision du comité -->
        <record id="notify_decision_comite" model="opex.workflow.action">
            <field name="name">5. Décision du comité</field>
            <field name="code">innovation_notify_decision_comite</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Le comité a rendu sa décision sur votre projet. Le motif figure dans l'historique de votre dossier.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <!-- 6. Remédiation demandée -->
        <record id="notify_remediation_demandee" model="opex.workflow.action">
            <field name="name">6. Remédiation demandée</field>
            <field name="code">innovation_notify_remediation_demandee</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <!-- Section 18 : le cluster ne dit pas « améliorez votre projet »,
                 il précise quoi corriger. Le message renvoie donc vers la liste
                 des points, il ne la remplace pas. -->
            <field name="body" type="html"><p>Votre projet nécessite des améliorations avant une nouvelle évaluation. Les points à corriger sont détaillés dans votre espace.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <!-- 7. Projet accepté -->
        <record id="notify_projet_accepte" model="opex.workflow.action">
            <field name="name">7. Projet accepté</field>
            <field name="code">innovation_notify_projet_accepte</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Votre projet a été accepté. L'accompagnement va pouvoir commencer.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <!-- 8. Matching proposé -->
        <record id="notify_matching_propose" model="opex.workflow.action">
            <field name="name">8. Matching proposé</field>
            <field name="code">innovation_notify_matching_propose</field>
            <field name="action_type">notify</field>
            <!-- Interne : « L'IA recommande, elle ne décide pas. » Le
                 responsable est prévenu qu'une liste l'attend, personne
                 d'autre. -->
            <field name="notify_subtype">note</field>
            <field name="body" type="html"><p>Le Smart Matching a produit ses recommandations. Elles attendent votre arbitrage : valider, modifier, exclure ou compléter.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_ceo')])]"/>
        </record>

        <!-- 9. Expert intéressé -->
        <record id="notify_expert_interesse" model="opex.workflow.action">
            <field name="name">9. Expert intéressé</field>
            <field name="code">innovation_notify_expert_interesse</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">note</field>
            <field name="body" type="html"><p>Un candidat proposé sur ce dossier s'est déclaré intéressé.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_ceo')])]"/>
        </record>

        <!--
             10. 11. 12. Les trois livrables

            **Configurées, mais non branchées.** Ces trois événements portent
            sur `opex.innovation.deliverable`, modèle de l'Extension 16, qui
            n'a pas été réalisée. Il n'existe donc aucune transition à laquelle
            les rattacher.

            Elles sont créées quand même, et c'est délibéré : la section 30
            énumère quatorze déclencheurs, et les quatorze doivent être
            auditables au même endroit. Le jour où l'Extension 16 sera faite,
            chacune se branche par une ligne de `<function>` — pas par du code.

            Un test vérifie que les quatorze existent, et **nomme** celles qui
            ne sont encore rattachées à rien. Une liste incomplète qui se
            tairait sur ses trous serait pire que pas de liste.
        -->
        <record id="notify_nouveau_livrable" model="opex.workflow.action">
            <field name="name">10. Nouveau livrable</field>
            <field name="code">innovation_notify_nouveau_livrable</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">note</field>
            <field name="body" type="html"><p>Nouveau livrable à vérifier.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_expert')])]"/>
        </record>

        <record id="notify_livrable_valide" model="opex.workflow.action">
            <field name="name">11. Livrable validé</field>
            <field name="code">innovation_notify_livrable_valide</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Votre livrable a été validé.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <record id="notify_correction_demandee" model="opex.workflow.action">
            <field name="name">12. Correction demandée</field>
            <field name="code">innovation_notify_correction_demandee</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Une correction est demandée sur votre livrable. Déposez une nouvelle version : l'historique des versions précédentes est conservé.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <!-- 13. Évolution du financement -->
        <record id="notify_evolution_financement" model="opex.workflow.action">
            <field name="name">13. Évolution du financement</field>
            <field name="code">innovation_notify_evolution_financement</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Le financement de votre projet a évolué. Le montant obtenu et la progression sont à jour dans votre espace.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <!-- 14. Projet clôturé -->
        <record id="notify_projet_cloture" model="opex.workflow.action">
            <field name="name">14. Projet clôturé</field>
            <field name="code">innovation_notify_projet_cloture</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Votre projet est clôturé. Le bilan de l'accompagnement est disponible, et votre avis nous intéresse.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <!--
            LES MOMENTS QUI NE DISAIENT RIEN

            Les quatorze notifications de la section 30 sont au-dessus. Les
            suivantes comblent des transitions qui ne notifiaient personne :
            le dossier avançait, et l'intéressé l'apprenait en rouvrant sa page.

            Sous-type : `comment` vers le porteur, `note` partout ailleurs.
            Ce n'est pas une question d'email seulement. Un `message_post` en
            `mt_comment` part **aussi aux followers** de l'enregistrement, et
            le porteur en est un : une coordination interne postée en
            `comment` lui arriverait. C'est le bug déjà corrigé une fois sur ce
            projet.
        -->

        <record id="notify_controle_en_cours" model="opex.workflow.action">
            <field name="name">Contrôle pris en charge</field>
            <field name="code">innovation_notify_controle_en_cours</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Le Secrétariat a pris votre projet en charge : le contrôle administratif est en cours.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <record id="notify_reevaluation_lancee" model="opex.workflow.action">
            <field name="name">Nouvelle évaluation à mener</field>
            <field name="code">innovation_notify_reevaluation_lancee</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">note</field>
            <field name="body" type="html"><p>Un projet corrigé revient devant le comité : une nouvelle évaluation est attendue.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_comite')])]"/>
        </record>

        <record id="notify_financement_lance" model="opex.workflow.action">
            <field name="name">Passage au financement</field>
            <field name="code">innovation_notify_financement_lance</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Votre accompagnement est terminé : votre projet entre en phase de financement.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <record id="notify_industrialisation_lancee" model="opex.workflow.action">
            <field name="name">Passage à l'industrialisation</field>
            <field name="code">innovation_notify_industrialisation_lancee</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">comment</field>
            <field name="body" type="html"><p>Votre projet entre en phase d'industrialisation.</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('opex_workflow.role_porteur')])]"/>
        </record>

        <!--
            Le rôle `evaluateur` ne recevait rien, sur aucune définition.

            Section 15 : « les évaluateurs apportent une expertise
            complémentaire lorsque le Comité l'estime nécessaire ». Les
            désigner sans les prévenir vidait l'Extension 13 de son sens — la
            ligne d'acteur leur ouvrait le dossier, et rien ne le leur disait.

            Déclenchée par `notify_event()` depuis `request_evaluation()` : la
            désignation d'un évaluateur n'est pas un passage d'étape. Le Python
            dit **quand**, ce fichier dit **quoi et à qui**.
        -->
        <record id="notify_evaluateur_sollicite" model="opex.workflow.action">
            <field name="name">Évaluateur sollicité</field>
            <field name="code">innovation_notify_evaluateur_sollicite</field>
            <field name="action_type">notify</field>
            <field name="notify_subtype">note</field>
            <field name="body" type="html"><p>Une évaluation vous est demandée sur ce projet. Retrouvez-la dans « Mes évaluations ».</p></field>
            <field name="target_role_ids" eval="[Command.set([ref('role_evaluateur')])]"/>
        </record>

    </data>

    <!--
        Le branchement sur les transitions

        Hors du bloc `noupdate`, et par `<function>` plutôt que par
        `<record>`.

        Les transitions existent déjà et portent le drapeau `noupdate` de leur
        création dans `project_workflow.xml`. Un `<record>` qui redéfinirait
        leur `action_ids` serait **ignoré** à la mise à jour : le branchement
        marcherait à l'installation d'une base neuve et nulle part ailleurs.
        Même piège qu'aux Extensions 10, 12, 15, 17 et 20.

        Chargé en dernier dans le manifeste, après `matching_criteria.xml` :
        celui-ci réécrit `action_ids` de `ptr_start_matching` avec un
        `Command.set`, qui remplace. D'où le `Command.link` ci-dessous pour
        cette transition-là — et un `Command.set` partout ailleurs, où l'on
        remplace volontairement le message générique par le message précis.
    -->

    <!-- 1. -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_submit')], {'action_ids': [
                  Command.set([ref('notify_projet_soumis')])]}]"/>

    <!-- 2. — et la resoumission après complément suit le même chemin retour. -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_request_complement')], {'action_ids': [
                  Command.set([ref('notify_complement_demande')])]}]"/>

    <!-- 3. -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_qualify')], {'action_ids': [
                  Command.set([ref('notify_projet_qualifie')])]}]"/>

    <!-- 4. — les deux chemins d'évaluation, avec ou sans experts. -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_evaluate_with_experts'), ref('ptr_evaluate_directly')],
                     {'action_ids': [Command.set([ref('notify_projet_evalue')])]}]"/>

    <!-- 5. — le refus est une décision du comité, et rien de plus. -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_reject')], {'action_ids': [
                  Command.set([ref('notify_decision_comite')])]}]"/>

    <!-- 5. + 6. — l'ajournement est une décision **et** une remédiation. Deux
         événements distincts de la section 30 sur la même transition : c'est
         le moteur qui les enchaîne, il n'y a pas à choisir. -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_adjourn')], {'action_ids': [Command.set([
                  ref('notify_decision_comite'),
                  ref('notify_remediation_demandee'),
              ])]}]"/>

    <!-- 7. -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_accept')], {'action_ids': [
                  Command.set([ref('notify_projet_accepte')])]}]"/>

    <!-- 8. — `link` et non `set` : les trois actions de matching sont déjà là. -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_start_matching')], {'action_ids': [
                  Command.link(ref('notify_matching_propose'))]}]"/>

    <!-- 14. -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_close')], {'action_ids': [
                  Command.set([ref('notify_projet_cloture')])]}]"/>

    <!--
        Les transitions qui ne notifiaient personne.

        `Command.link` et non `Command.set` : ces transitions portent déjà,
        pour certaines, des actions d'un autre type (`set_field`,
        `launch_subworkflow`). Un `set` les effacerait au passage — c'est la
        troisième face du piège documenté plus haut.
    -->
    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_take_in_charge')], {'action_ids': [
                  Command.link(ref('notify_controle_en_cours'))]}]"/>

    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_reevaluate')], {'action_ids': [
                  Command.link(ref('notify_reevaluation_lancee'))]}]"/>

    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_start_financement')], {'action_ids': [
                  Command.link(ref('notify_financement_lance'))]}]"/>

    <function model="opex.workflow.transition" name="write"
              eval="[[ref('ptr_start_industrialisation')], {'action_ids': [
                  Command.link(ref('notify_industrialisation_lancee'))]}]"/>

    <!--
        Le canal par lequel le personnel reçoit

        Poster un message ne suffit pas : encore faut-il qu'il s'affiche
        quelque part. Les comptes internes créés par un administrateur sont en
        `notification_type = 'email'` par défaut — leurs notifications partent
        par courriel et **le systray natif reste vide**. Le personnel ne voyait
        donc aucune des notes qui lui sont adressées.

        On réutilise la cloche **native** d'Odoo là où elle fonctionne, plutôt
        que d'étendre la cloche maison du portail à un second public : celle-ci
        n'existe que parce qu'Odoo interdit `inbox` aux comptes partagés
        (`CHECK (notification_type = 'email' OR NOT share)`), contrainte qui ne
        vise pas les internes.

        Hors bloc `noupdate` : rejoué à chaque mise à jour, donc un membre du
        personnel ajouté plus tard est réglé au déploiement suivant.
    -->
    <function model="res.users" name="_opex_innovation_enable_inbox"/>

</odoo>
