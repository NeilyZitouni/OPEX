<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_opex" model="ir.module.category">
        <field name="name">GIC OPEX Group</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_opex_membership" model="res.groups.privilege">
        <field name="name">Membership</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_opex"/>
    </record>

    <record id="group_secretariat" model="res.groups">
        <field name="name">Secrétariat</field>
        <field name="privilege_id" ref="privilege_opex_membership"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Contrôle administratif des dossiers d'adhésion, gestion des cotisations et des paiements.</field>
    </record>

    <!--
        Le Comité d'admission est un acteur à part entière (acteur 4 de la
        spécification UX), distinct du COPIL : il examine le dossier et rend un
        avis motivé, le COPIL décide ensuite. Les fusionner reviendrait à faire
        prendre la décision finale par celui qui l'a instruite.

        Même `res.groups.privilege` que Secrétariat et COPIL : les trois rôles
        sont donc mutuellement exclusifs dans le sélecteur simple, ce qui est
        le comportement voulu — on n'instruit pas un dossier qu'on validera.
    -->
    <record id="group_comite" model="res.groups">
        <field name="name">Comité d'admission</field>
        <field name="privilege_id" ref="privilege_opex_membership"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Examen des dossiers d'adhésion et émission d'un avis motivé à l'attention du COPIL.</field>
    </record>

    <record id="group_copil" model="res.groups">
        <field name="name">COPIL</field>
        <field name="privilege_id" ref="privilege_opex_membership"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Validation finale des dossiers d'adhésion.</field>
    </record>
</odoo>