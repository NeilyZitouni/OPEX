<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Visibilité conditionnelle de l'entrée « Vie du Cluster » du menu
        principal.

        L'entrée elle-même est un `website.menu` classique
        (`data/website_menu.xml`), au même niveau que « Annuaire » et
        « Devenir membre » — c'est ce qui la place dans le menu de gauche
        plutôt que dans la zone compte à droite, et ce qui la rend éditable
        depuis l'éditeur de site comme les autres.

        Mais un `website.menu` ne sait pas se conditionner à une donnée
        métier : son champ natif `group_ids` ne raisonne qu'en groupes, or
        notre règle porte sur `res.partner.is_member`, qu'aucun groupe
        n'exprime. D'où ce greffon sur `website.submenu`, le gabarit unique
        par lequel passent toutes les variantes d'en-tête du module
        `website` — un seul point d'insertion couvre donc tous les thèmes.

        Le surcoût ne pèse que sur notre entrée : pour tous les autres
        menus, `opex_is_cluster_menu` est faux et Python court-circuite
        avant d'évaluer la moindre appartenance.

        `o_no_autohide_item` : sans cette classe, `autoHideMenu` replie
        l'entrée dans le « + » de débordement dès que l'en-tête est chargé.
        Elle serait alors présente dans le HTML et invisible à l'écran —
        le travers décrit par la règle transversale de CLAUDE.md. Vérifié
        dans `auto_hide_menu.js` : la classe figure bien dans le sélecteur
        `unfoldable` appliqué à `.top_menu`.

        Repérage par URL plutôt que par identifiant externe : si
        l'utilisateur change l'URL de l'entrée depuis l'éditeur, le
        garde-fou cesse de s'appliquer et le lien redevient visible de
        tous. Ce n'est pas une faille — `_cluster_access_denied()` refuse
        toujours l'accès côté serveur, le visiteur est simplement redirigé
        avec le message d'explication.
    -->
    <template id="website_submenu_cluster_visibility"
              name="Menu principal : visibilité de « Vie du Cluster »"
              inherit_id="website.submenu" priority="20">
        <xpath expr="//t[@t-set='show_dropdown']" position="before">
            <t t-set="opex_is_cluster_menu" t-value="submenu.url == '/my/cluster/news'"/>
            <t t-set="opex_cluster_menu_denied"
               t-value="opex_is_cluster_menu
                        and not (request.env.user.partner_id.sudo().is_member
                                 or request.env.user._is_opex_staff())"/>
        </xpath>
        <xpath expr="//li[@t-if]" position="attributes">
            <attribute name="t-if" add="not opex_cluster_menu_denied" separator="and"/>
            <attribute name="t-attf-class" separator=" "
                       add="#{opex_is_cluster_menu and 'o_no_autohide_item' or ''}"/>
        </xpath>
        <!-- Même garde si l'utilisateur ajoute un sous-menu sous l'entrée
             depuis l'éditeur : elle bascule alors sur la branche « dropdown ». -->
        <xpath expr="//li[@t-elif]" position="attributes">
            <attribute name="t-elif" add="not opex_cluster_menu_denied" separator="and"/>
            <attribute name="t-attf-class" separator=" "
                       add="#{opex_is_cluster_menu and 'o_no_autohide_item' or ''}"/>
        </xpath>
    </template>

    <!--
        Carte « Vie du Cluster » sur l'accueil du portail.

        Réservée aux membres actifs, comme les pages elles-mêmes : proposer une
        tuile qui renvoie aussitôt sur cette même page serait déroutant. Ce
        `t-if` reste un confort d'affichage — c'est le controller qui refuse
        réellement l'accès.
    -->
    <template id="portal_my_home_cluster" name="Portail : vie du cluster"
              customize_show="True" inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>

            <!-- Refus expliqué au candidat qui a tenté d'ouvrir une page
                 Vie du Cluster : le drapeau vient de l'URL, le texte non. -->
            <div t-if="request.params.get('cluster') == 'members_only'"
                 class="alert alert-info" role="alert">
                <strong>La Vie du Cluster est réservée aux membres actifs.</strong>
                <div class="small mb-0">
                    Vos actualités, événements et formations s'ouvriront dès que
                    votre adhésion au GIC OPEX Group sera activée. Vous pouvez
                    suivre l'avancement de votre dossier depuis
                    <a href="/my/membership">Mes dossiers d'adhésion</a>.
                </div>
            </div>
        </xpath>
        <div id="portal_client_category" position="inside">
            <!-- Même condition que le controller : membre actif, ou personnel
                 interne venu prévisualiser. -->
            <t t-if="request.env.user.partner_id.sudo().is_member
                     or request.env.user._is_opex_staff()">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Vie du Cluster</t>
                    <t t-set="text">Actualités, événements, formations, documents et groupes</t>
                    <t t-set="url" t-value="'/my/cluster/news'"/>
                    <!--
                        `config_card` : sans lui, `portal.portal_docs_entry`
                        ajoute `d-none` à la tuile et celle-ci n'apparaît jamais.
                        Le mécanisme natif ne montre une tuile que si un
                        `placeholder_count` non nul lui est fourni — or la Vie du
                        Cluster n'a pas de compteur qui lui soit propre, et une
                        tuile qui disparaîtrait faute d'actualités serait pire
                        que pas de tuile du tout. `config_card` est la voie
                        prévue par Odoo pour les entrées toujours visibles.
                    -->
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>
        </div>
    </template>

    <!-- Fil d'Ariane des pages Vie du Cluster -->
    <template id="portal_breadcrumbs_cluster" name="Portail : fil d'Ariane vie du cluster"
              inherit_id="portal.portal_breadcrumbs" priority="50">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('cluster_news', 'cluster_events', 'cluster_trainings',
                                    'cluster_documents', 'cluster_groups')"
                class="breadcrumb-item active">
                Vie du Cluster
            </li>
        </xpath>
    </template>

    <!-- Navigation commune aux trois pages -->
    <template id="portal_cluster_nav" name="Portail : navigation vie du cluster">
        <ul class="nav nav-pills mb-4">
            <li class="nav-item">
                <a t-attf-class="nav-link #{'active' if cluster_page == 'news' else ''}"
                   href="/my/cluster/news">Actualités</a>
            </li>
            <li class="nav-item">
                <a t-attf-class="nav-link #{'active' if cluster_page == 'events' else ''}"
                   href="/my/cluster/events">Événements</a>
            </li>
            <li class="nav-item">
                <a t-attf-class="nav-link #{'active' if cluster_page == 'trainings' else ''}"
                   href="/my/cluster/trainings">Formations</a>
            </li>
            <li class="nav-item">
                <a t-attf-class="nav-link #{'active' if cluster_page == 'documents' else ''}"
                   href="/my/cluster/documents">Documents</a>
            </li>
            <li class="nav-item">
                <a t-attf-class="nav-link #{'active' if cluster_page == 'groups' else ''}"
                   href="/my/cluster/groups">Forums et groupes</a>
            </li>
        </ul>
    </template>

    <!-- /my/cluster/news -->
    <template id="portal_cluster_news" name="Portail : actualités du cluster">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Vie du Cluster</t>
            </t>
            <t t-call="opex_membership.portal_cluster_nav"/>

            <div t-if="not news_items" class="alert alert-info" role="alert">
                Aucune actualité publiée pour le moment.
            </div>

            <div t-else="" class="row g-3">
                <div t-foreach="news_items" t-as="news" class="col-md-6">
                    <div class="card h-100">
                        <img t-if="news.image" class="card-img-top"
                             t-attf-src="/web/image/opex.cluster.news/#{news.id}/image"
                             t-att-alt="news.title"/>
                        <div class="card-body">
                            <span t-if="news.category" class="badge text-bg-light mb-2">
                                <t t-out="news.category"/>
                            </span>
                            <h5 class="card-title"><t t-out="news.title"/></h5>
                            <p class="text-muted small mb-2">
                                <i class="fa fa-calendar fa-fw me-1"/>
                                <span t-field="news.publish_date"/>
                            </p>
                            <div t-if="news.content" t-out="news.content"/>
                            <div t-if="news.attachment_ids" class="mt-3">
                                <a t-foreach="news.attachment_ids" t-as="attachment"
                                   t-attf-href="/web/content/#{attachment.id}?download=true"
                                   class="d-block small">
                                    <i class="fa fa-paperclip me-1"/><t t-out="attachment.name"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- /my/cluster/events -->
    <template id="portal_cluster_events" name="Portail : événements du cluster">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Vie du Cluster</t>
            </t>
            <t t-call="opex_membership.portal_cluster_nav"/>

            <div t-if="error" class="alert alert-danger" role="alert">
                <t t-out="error"/>
            </div>

            <div t-if="not events" class="alert alert-info" role="alert">
                Aucun événement programmé pour le moment.
            </div>

            <div t-else="" class="list-group">
                <div t-foreach="events" t-as="event"
                     class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="mb-1"><t t-out="event.name"/></h6>
                        <div class="text-muted small">
                            <span class="badge text-bg-light me-2">
                                <t t-out="dict(event._fields['type'].selection)[event.type]"/>
                            </span>
                            <i class="fa fa-calendar fa-fw me-1"/>
                            <span t-field="event.date_debut"/>
                            <t t-if="event.lieu">
                                <i class="fa fa-map-marker fa-fw ms-2 me-1"/>
                                <t t-out="event.lieu"/>
                            </t>
                        </div>
                    </div>
                    <div>
                        <span t-if="event.id in registered_event_ids"
                              class="badge text-bg-success">
                            <i class="fa fa-check me-1"/>Vous participez
                        </span>
                        <form t-else=""
                              t-attf-action="/my/cluster/events/#{event.id}/register"
                              method="post" class="mb-0">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-sm btn-primary">
                                Participer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- /my/cluster/trainings -->
    <template id="portal_cluster_trainings" name="Portail : formations du cluster">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Vie du Cluster</t>
            </t>
            <t t-call="opex_membership.portal_cluster_nav"/>

            <div t-if="error" class="alert alert-danger" role="alert">
                <t t-out="error"/>
            </div>

            <div t-if="not trainings" class="alert alert-info" role="alert">
                Aucune formation programmée pour le moment.
            </div>

            <div t-else="" class="list-group">
                <div t-foreach="trainings" t-as="training"
                     class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="mb-1"><t t-out="training.name"/></h6>
                        <div class="text-muted small">
                            <t t-if="training.date">
                                <i class="fa fa-calendar fa-fw me-1"/>
                                <span t-field="training.date"/>
                            </t>
                            <t t-if="training.duration">
                                <i class="fa fa-clock-o fa-fw ms-2 me-1"/>
                                <t t-out="training.duration"/> h
                            </t>
                            <span t-attf-class="ms-2 badge #{
                                    'text-bg-secondary' if not training.seats_available
                                    else 'text-bg-light'}">
                                <t t-out="training.seats_available"/>
                                place<t t-if="training.seats_available &gt; 1">s</t>
                                sur <t t-out="training.seats_total"/>
                            </span>
                        </div>
                    </div>
                    <div>
                        <span t-if="training.id in registered_training_ids"
                              class="badge text-bg-success">
                            <i class="fa fa-check me-1"/>Vous êtes inscrit
                        </span>
                        <!-- Bouton neutralisé quand il n'y a plus de place ;
                             le modèle refuse de toute façon l'inscription. -->
                        <span t-elif="not training.seats_available"
                              class="badge text-bg-secondary">Complet</span>
                        <form t-else=""
                              t-attf-action="/my/cluster/trainings/#{training.id}/register"
                              method="post" class="mb-0">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-sm btn-primary">
                                S'inscrire
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- /my/cluster/documents -->
    <template id="portal_cluster_documents" name="Portail : documents du cluster">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Vie du Cluster</t>
            </t>
            <t t-call="opex_membership.portal_cluster_nav"/>

            <!-- Le personnel qui prévisualise doit savoir qu'il voit plus que
                 les membres, sans quoi il croirait la page identique. -->
            <div t-if="sees_committee_documents" class="alert alert-light border" role="alert">
                <i class="fa fa-eye me-1"/>
                Prévisualisation interne : les documents de niveau « Comité » sont
                inclus ici, un membre ne les voit pas.
            </div>

            <div t-if="not document_folders" class="alert alert-info" role="alert">
                Aucun document partagé pour le moment.
            </div>

            <t t-else="">
                <t t-foreach="document_folders" t-as="folder">
                    <h6 class="mt-4">
                        <i class="fa fa-folder-open-o me-1"/><t t-out="folder[0]"/>
                    </h6>
                    <div class="list-group">
                        <div t-foreach="folder[1]" t-as="document"
                             class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <t t-out="document.name"/>
                                <span t-if="document.version" class="badge text-bg-light ms-2">
                                    v<t t-out="document.version"/>
                                </span>
                                <span t-if="document.confidentiality == 'committee'"
                                      class="badge text-bg-warning ms-1">Comité</span>
                            </div>
                            <a t-if="document.file"
                               t-attf-href="/web/content?model=opex.cluster.document&amp;id=#{document.id}&amp;field=file&amp;filename_field=filename&amp;download=true"
                               class="btn btn-sm btn-light">
                                <i class="fa fa-download me-1"/>Télécharger
                            </a>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- /my/cluster/groups -->
    <template id="portal_cluster_groups" name="Portail : forums et groupes du cluster">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Vie du Cluster</t>
            </t>
            <t t-call="opex_membership.portal_cluster_nav"/>

            <div t-if="not groups" class="alert alert-info" role="alert">
                Aucun forum ni groupe de travail pour le moment.
            </div>

            <div t-else="" class="row g-3">
                <div t-foreach="groups" t-as="group" class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h6 class="card-title mb-1"><t t-out="group.name"/></h6>
                                <span t-if="group.id in my_group_ids"
                                      class="badge text-bg-success">
                                    <i class="fa fa-check me-1"/>Vous en faites partie
                                </span>
                            </div>
                            <p t-if="group.description" class="text-muted small mb-2">
                                <t t-out="group.description"/>
                            </p>
                            <span class="badge text-bg-light">
                                <t t-out="group.member_count"/>
                                membre<t t-if="group.member_count &gt; 1">s</t>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <p class="text-muted small mt-3">
                L'adhésion à un forum ou groupe de travail est gérée par le Secrétariat
                du GIC OPEX Group.
            </p>
        </t>
    </template>

</odoo>
