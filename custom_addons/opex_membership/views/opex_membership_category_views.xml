<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_opex_membership_category_list" model="ir.ui.view">
        <field name="name">opex.membership.category.list</field>
        <field name="model">opex.membership.category</field>
        <field name="arch" type="xml">
            <list string="Catégories d'adhésion">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="subcategory_count"/>
            </list>
        </field>
    </record>

    <record id="view_opex_membership_category_form" model="ir.ui.view">
        <field name="name">opex.membership.category.form</field>
        <field name="model">opex.membership.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie d'adhésion">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="droits_acces"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Le barème vit sur la sous-catégorie : c'est elle
                             que le candidat choisit et que la cotisation facture. -->
                        <page string="Sous-catégories" name="subcategories">
                            <field name="subcategory_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="critere_eligibilite"/>
                                    <field name="montant_cotisation"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_opex_membership_category" model="ir.actions.act_window">
        <field name="name">Catégories d'adhésion</field>
        <field name="res_model">opex.membership.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
