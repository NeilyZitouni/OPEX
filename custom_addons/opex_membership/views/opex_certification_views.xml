<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_opex_certification_list" model="ir.ui.view">
        <field name="name">opex.certification.list</field>
        <field name="model">opex.certification</field>
        <field name="arch" type="xml">
            <list string="Certifications" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_opex_certification" model="ir.actions.act_window">
        <field name="name">Certifications</field>
        <field name="res_model">opex.certification</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
