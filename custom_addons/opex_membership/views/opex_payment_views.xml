<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_opex_payment_list" model="ir.ui.view">
        <field name="name">opex.payment.list</field>
        <field name="model">opex.payment</field>
        <field name="arch" type="xml">
            <list string="Paiements">
                <field name="subscription_id"/>
                <field name="date_paiement"/>
                <field name="montant"/>
                <field name="mode_paiement"/>
                <field name="reference_transaction"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'to_verify'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_opex_payment_form" model="ir.ui.view">
        <field name="name">opex.payment.form</field>
        <field name="model">opex.payment</field>
        <field name="arch" type="xml">
            <form string="Paiement">
                <header>
                    <!-- Le rejet exige un motif : il se saisit dans le champ
                         ci-dessous, que le bouton reprend tel quel. -->
                    <button name="action_confirm" type="object" string="Confirmer le paiement"
                            class="oe_highlight" invisible="state != 'to_verify'"
                            groups="opex_membership.group_secretariat"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="to_verify,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="subscription_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="montant"/>
                            <field name="date_paiement"/>
                        </group>
                        <group>
                            <field name="mode_paiement"/>
                            <field name="reference_transaction"/>
                            <field name="date_verification" readonly="1"
                                   invisible="not date_verification"/>
                            <field name="motif_rejet" readonly="1"
                                   invisible="state != 'rejected'"/>
                        </group>
                    </group>
                    <group string="Justificatif" invisible="not justificatif">
                        <field name="justificatif" filename="justificatif_filename"
                               widget="binary" readonly="1"/>
                        <field name="justificatif_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_opex_payment" model="ir.actions.act_window">
        <field name="name">Paiements</field>
        <field name="res_model">opex.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
