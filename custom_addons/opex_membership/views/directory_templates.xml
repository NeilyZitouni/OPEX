<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- /opex/directory : annuaire public des membres du cluster -->
    <template id="directory_page" name="Annuaire des membres">
        <t t-call="website.layout">
            <!-- `oe_structure` reste sur des zones vides : les blocs déposés
                 depuis l'éditeur de site n'écrasent alors pas le contenu
                 dynamique de la page. -->
            <div id="wrap">
                <div class="oe_structure"/>

                <section class="pt32 pb16">
                    <div class="container">
                        <h1 class="mb-2">Annuaire des membres</h1>
                        <p class="lead text-muted mb-0">
                            Les entreprises et experts membres du GIC OPEX Group qui ont
                            choisi de figurer dans l'annuaire public du cluster.
                        </p>
                    </div>
                </section>

                <section class="pb32">
                    <div class="container">
                        <!-- Recherche multicritère : en GET, pour que les résultats
                             restent partageables par simple copie de l'URL. -->
                        <form action="/opex/directory" method="get" class="row g-2 align-items-end mb-4">
                            <div class="col-md-4">
                                <label class="form-label" for="q">Nom</label>
                                <input type="text" name="q" id="q" class="form-control"
                                       placeholder="Rechercher un membre…"
                                       t-att-value="search['q']"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="secteur">Secteur d'activité</label>
                                <select name="secteur" id="secteur" class="form-select">
                                    <option value="">Tous les secteurs</option>
                                    <option t-foreach="secteurs" t-as="secteur"
                                            t-att-value="secteur"
                                            t-att-selected="'selected' if search['secteur'] == secteur else None">
                                        <t t-out="secteur"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="wilaya">Wilaya</label>
                                <select name="wilaya" id="wilaya" class="form-select">
                                    <option value="">Toutes les wilayas</option>
                                    <option t-foreach="wilayas" t-as="wilaya"
                                            t-att-value="wilaya"
                                            t-att-selected="'selected' if search['wilaya'] == wilaya else None">
                                        <t t-out="wilaya"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex gap-2">
                                <button type="submit" class="btn btn-primary flex-grow-1">
                                    <i class="fa fa-search me-1"/>Filtrer
                                </button>
                                <a t-if="search['q'] or search['secteur'] or search['wilaya']"
                                   href="/opex/directory" class="btn btn-light" title="Réinitialiser">
                                    <i class="fa fa-times"/>
                                </a>
                            </div>
                        </form>

                        <div t-if="not members" class="alert alert-info" role="alert">
                            Aucun membre ne correspond à cette recherche.
                        </div>

                        <t t-else="">
                            <p class="text-muted">
                                <t t-out="member_count"/>
                                <t t-if="member_count &gt; 1"> membres</t>
                                <t t-else=""> membre</t>
                            </p>

                            <div class="row g-3">
                                <div t-foreach="members" t-as="member" class="col-lg-4 col-md-6">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h5 class="card-title mb-1"><t t-out="member['name']"/></h5>
                                            <span t-if="member['categorie_membre_id']"
                                                  class="badge text-bg-primary mb-2">
                                                <t t-out="member['categorie_membre_id']"/>
                                            </span>
                                            <ul class="list-unstyled text-muted mb-0 mt-2">
                                                <li t-if="member['secteur_activite']">
                                                    <i class="fa fa-briefcase fa-fw me-1"/>
                                                    <t t-out="member['secteur_activite']"/>
                                                </li>
                                                <li t-if="member['wilaya']">
                                                    <i class="fa fa-map-marker fa-fw me-1"/>
                                                    <t t-out="member['wilaya']"/>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-center mt-4">
                                <t t-call="portal.pager"/>
                            </div>
                        </t>

                        <div class="alert alert-light border mt-4" role="alert">
                            Votre entreprise n'apparaît pas encore dans cet annuaire ?
                            <a href="/web/signup?redirect=/my/membership/new">Devenez membre du cluster</a>.
                        </div>
                    </div>
                </section>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>

</odoo>
