<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_opex_cluster_event_list" model="ir.ui.view">
        <field name="name">opex.cluster.event.list</field>
        <field name="model">opex.cluster.event</field>
        <field name="arch" type="xml">
            <list string="Événements">
                <field name="name"/>
                <field name="type"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="lieu"/>
            </list>
        </field>
    </record>

    <record id="view_opex_cluster_event_form" model="ir.ui.view">
        <field name="name">opex.cluster.event.form</field>
        <field name="model">opex.cluster.event</field>
        <field name="arch" type="xml">
            <form string="Événement">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                        <field name="lieu"/>
                    </group>
                    <group>
                        <group>
                            <field name="date_debut"/>
                        </group>
                        <group>
                            <field name="date_fin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Participants" name="participants">
                            <field name="partner_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_opex_cluster_event" model="ir.actions.act_window">
        <field name="name">Événements</field>
        <field name="res_model">opex.cluster.event</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
