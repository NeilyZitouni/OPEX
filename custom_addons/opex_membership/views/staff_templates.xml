<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Liens de navigation ajoutés au header du site.

        `portal.placeholder_user_sign_in` est le point d'extension rendu par
        toutes les variantes d'en-tête du module `website` : y greffer les liens
        les rend disponibles quel que soit l'en-tête choisi dans l'éditeur.
    -->
    <template id="website_header_staff_links" name="En-tête : liens portail OPEX"
              inherit_id="portal.placeholder_user_sign_in">
        <xpath expr="." position="inside">
            <!-- Espace de traitement : réservé au personnel interne. Un
                 candidat portail comme un visiteur anonyme n'a aucun des trois
                 groupes, le lien n'existe donc pas dans leur page. -->
            <li t-if="request.env.user.has_group('opex_membership.group_secretariat')
                      or request.env.user.has_group('opex_membership.group_comite')
                      or request.env.user.has_group('opex_membership.group_copil')
                      or request.env.user.has_group('base.group_system')"
                t-attf-class="#{_item_class} o_no_autohide_item">
                <a href="/staff/membership" t-attf-class="#{_link_class}">Espace validation</a>
            </li>
            <!-- Point d'entrée du personnel interne, aligné sur le « Sign in »
                 natif : masqué dès qu'une session est ouverte, le menu
                 utilisateur prenant alors le relais. -->
            <li groups="base.group_public" t-attf-class="#{_item_class} o_no_autohide_item">
                <a href="/web/login" t-attf-class="#{_link_class}">Connexion</a>
            </li>
        </xpath>
    </template>

    <!--
        Tuile « Espace validation » sur l'accueil du portail.

        Même question que les routes `/staff/…` : `res.users._is_opex_staff()`,
        et rien d'autre. Le `t-if` ne fait qu'afficher — c'est `_is_staff()`,
        côté controller, qui refuse réellement l'accès (règle transversale 2 :
        un contrôle, un seul endroit, appelé par la tuile et par la route).

        `config_card` : sans lui, `portal.portal_docs_entry` rend la carte avec
        `d-none` et ne la réaffiche que si un compteur asynchrone revient
        strictement positif. Une file de traitement vide est une information —
        « rien ne vous attend » — et la tuile ne doit pas disparaître pour
        autant. Piège déjà payé sur la tuile Vie du Cluster.
    -->
    <template id="portal_my_home_staff" name="Portail : espace validation"
              customize_show="True" inherit_id="portal.portal_my_home" priority="60">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-if="request.env.user._is_opex_staff()">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Espace validation</t>
                    <t t-set="text">Dossiers d'adhésion à contrôler, à examiner et à valider</t>
                    <t t-set="url" t-value="'/staff/membership'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>
        </div>
    </template>

    <!-- Pastille d'état, en-tête de page et fil d'Ariane communs aux 2 pages -->
    <template id="staff_page_header" name="Espace validation : en-tête">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <div>
                <h1 class="mb-1">Espace validation</h1>
                <p class="text-muted mb-0">
                    Traitement des dossiers d'adhésion — <t t-out="request.env.user.name"/>
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="/staff/dashboard" class="btn btn-light">
                    <i class="fa fa-dashboard me-1"/>Tableau de bord
                </a>
                <a href="/staff/membership" class="btn btn-light">
                    <i class="fa fa-list me-1"/>Dossiers à traiter
                </a>
            </div>
        </div>
    </template>

    <!--
        /staff/dashboard : tableau de bord du Secrétariat (section 42).

        Chaque chiffre affiché ici vient d'un comptage fait au rendu de la
        page ; il n'existe aucun compteur stocké à resynchroniser.
    -->
    <template id="staff_dashboard" name="Espace validation : tableau de bord">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure"/>

                <section class="py-5">
                    <div class="container">
                        <t t-call="opex_membership.staff_page_header"/>

                        <div class="row g-4">
                            <!-- Demandes d'adhésion par état -->
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">Demandes d'adhésion</h6>
                                        <span class="badge text-bg-secondary">
                                            <t t-out="file_total"/> au total
                                        </span>
                                    </div>
                                    <div class="card-body p-0">
                                        <table class="table table-sm mb-0">
                                            <tbody>
                                                <tr t-foreach="file_counts" t-as="entry"
                                                    t-attf-class="#{'text-muted' if not entry['count'] else ''}">
                                                    <td><t t-out="entry['label']"/></td>
                                                    <td class="text-end fw-bold" style="width: 5rem;">
                                                        <t t-out="entry['count']"/>
                                                    </td>
                                                    <td class="text-end" style="width: 7rem;">
                                                        <a t-if="entry['count']"
                                                           href="/staff/membership"
                                                           class="small">Traiter</a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Cotisations -->
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">Cotisations</h6>
                                        <span class="badge text-bg-secondary">
                                            <t t-out="subscription_total"/> au total
                                        </span>
                                    </div>
                                    <div class="card-body p-0">
                                        <table class="table table-sm mb-0">
                                            <tbody>
                                                <tr t-foreach="subscription_counts" t-as="entry"
                                                    t-attf-class="#{'text-muted' if not entry['count'] else ''}">
                                                    <td>
                                                        <t t-out="entry['label']"/>
                                                        <i t-if="entry['state'] == 'late' and entry['count']"
                                                           class="fa fa-exclamation-triangle text-danger ms-1"/>
                                                    </td>
                                                    <td class="text-end fw-bold" style="width: 5rem;">
                                                        <t t-out="entry['count']"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Membres -->
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header"><h6 class="mb-0">Membres</h6></div>
                                    <div class="card-body">
                                        <div class="row text-center">
                                            <div class="col-6">
                                                <div class="display-6"><t t-out="active_members"/></div>
                                                <div class="text-muted small">membres actifs</div>
                                            </div>
                                            <div class="col-6">
                                                <div class="display-6"><t t-out="new_members_this_month"/></div>
                                                <div class="text-muted small">nouveaux ce mois</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Vie du Cluster -->
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header"><h6 class="mb-0">Vie du Cluster</h6></div>
                                    <div class="card-body p-0">
                                        <table class="table table-sm mb-0">
                                            <tbody>
                                                <tr>
                                                    <td>Événements à venir</td>
                                                    <td class="text-end fw-bold"><t t-out="upcoming_events"/></td>
                                                </tr>
                                                <tr>
                                                    <td>Formations à venir</td>
                                                    <td class="text-end fw-bold"><t t-out="upcoming_trainings"/></td>
                                                </tr>
                                                <tr>
                                                    <td>Assemblées générales à venir</td>
                                                    <td class="text-end fw-bold"><t t-out="upcoming_assemblies"/></td>
                                                </tr>
                                                <tr>
                                                    <td>Actualités publiées</td>
                                                    <td class="text-end fw-bold"><t t-out="published_news"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <!-- /staff/membership : file d'attente du rôle connecté -->
    <template id="staff_membership_files" name="Espace validation : dossiers à traiter">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure"/>

                <section class="py-5">
                    <div class="container">
                        <t t-call="opex_membership.staff_page_header"/>

                        <div t-if="not membership_files" class="alert alert-info" role="alert">
                            Aucun dossier n'attend votre intervention pour le moment.
                        </div>

                        <div t-else="" class="table-responsive">
                            <table class="table table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th>Candidat</th>
                                        <th>Catégorie demandée</th>
                                        <th>Date de dépôt</th>
                                        <th class="text-center">État</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="membership_files" t-as="membership_file">
                                        <td>
                                            <span t-field="membership_file.partner_id"/>
                                            <div class="text-muted small">
                                                Dossier n° <t t-out="membership_file.id"/>
                                            </div>
                                        </td>
                                        <td><span t-field="membership_file.subcategory_id"/></td>
                                        <td>
                                            <span t-field="membership_file.date_depot"
                                                  t-options="{'widget': 'date'}"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-call="opex_membership.portal_membership_state_badge"/>
                                        </td>
                                        <td class="text-end">
                                            <a t-attf-href="/staff/membership/#{membership_file.id}"
                                               class="btn btn-sm btn-primary">Traiter</a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-center mt-4">
                            <t t-call="portal.pager"/>
                        </div>
                    </div>
                </section>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <!-- /staff/membership/<id> : détail et action de validation -->
    <template id="staff_membership_file_page" name="Espace validation : détail du dossier">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure"/>

                <section class="py-5">
                    <div class="container">
                        <t t-call="opex_membership.staff_page_header"/>

                        <!-- Message d'erreur remonté tel quel par le modèle : le
                             controller ne réinterprète pas la règle métier. -->
                        <div t-if="error" class="alert alert-danger" role="alert">
                            <t t-out="error"/>
                        </div>

                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <h5 class="mb-0">
                                    Dossier n° <t t-out="membership_file.id"/> —
                                    <span t-field="membership_file.partner_id"/>
                                </h5>
                                <t t-call="opex_membership.portal_membership_state_badge"/>
                            </div>

                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <strong>Candidat</strong>
                                        <div><span t-field="membership_file.partner_id"/></div>
                                        <div t-if="membership_file.partner_id.email" class="text-muted">
                                            <span t-field="membership_file.partner_id.email"/>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <strong>Catégorie demandée</strong>
                                        <div><span t-field="membership_file.subcategory_id"/></div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <strong>Organisation</strong>
                                        <div>
                                            <t t-out="membership_file.nom_legal or membership_file.partner_id.name"/>
                                        </div>
                                        <div t-if="membership_file.forme_juridique" class="text-muted small">
                                            <t t-out="membership_file.forme_juridique"/>
                                            <t t-if="membership_file.rc"> — RC <t t-out="membership_file.rc"/></t>
                                            <t t-if="membership_file.nif"> — NIF <t t-out="membership_file.nif"/></t>
                                        </div>
                                    </div>
                                    <div t-if="membership_file.representant_nom" class="col-md-6 mb-3">
                                        <strong>Représentant</strong>
                                        <div>
                                            <t t-out="membership_file.representant_prenom or ''"/>
                                            <t t-out="membership_file.representant_nom"/>
                                            <t t-if="membership_file.representant_fonction">
                                                — <t t-out="membership_file.representant_fonction"/>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <strong>Date de dépôt</strong>
                                        <div><span t-field="membership_file.date_depot"/></div>
                                    </div>
                                    <div t-if="membership_file.signature_date" class="col-md-6 mb-3">
                                        <strong>Date de signature de la charte</strong>
                                        <div><span t-field="membership_file.signature_date"/></div>
                                    </div>
                                </div>

                                <h6 class="mt-3">Pièces du dossier</h6>
                                <div t-if="not membership_file.document_ids" class="text-muted">
                                    Aucune pièce jointe : le dossier ne peut pas être transmis au comité.
                                </div>
                                <ul t-else="" class="list-unstyled">
                                    <li t-foreach="membership_file.document_ids" t-as="document">
                                        <i class="fa fa-paperclip me-1"/>
                                        <!-- Les pièces ne sont plus des `ir.attachment` :
                                             le téléchargement passe par le champ binaire
                                             du modèle, pas par l'id d'une pièce jointe. -->
                                        <a t-attf-href="/web/content?model=opex.membership.document&amp;id=#{document.id}&amp;field=file&amp;filename_field=filename&amp;download=true">
                                            <t t-out="document.name"/>
                                        </a>
                                        <span class="text-muted small">
                                            — <t t-out="dict(document._fields['document_type'].selection)[document.document_type]"/>
                                        </span>
                                        <span t-if="document.is_required" class="badge text-bg-light">obligatoire</span>
                                    </li>
                                </ul>

                                <t t-set="missing" t-value="membership_file._missing_required_documents()"/>
                                <div t-if="missing" class="alert alert-warning mt-2" role="alert">
                                    Pièces obligatoires manquantes : <t t-out="', '.join(missing)"/>.
                                </div>

                                <!-- Avis rendu par le Comité : c'est l'élément
                                     que le COPIL consulte avant de décider
                                     (section 22 de la spécification). -->
                                <t t-if="membership_file.avis_comite">
                                    <h6 class="mt-4">Avis du Comité d'admission</h6>
                                    <p class="mb-1">
                                        <span t-attf-class="badge #{
                                                'text-bg-success' if membership_file.avis_comite == 'favorable'
                                                else 'text-bg-danger' if membership_file.avis_comite == 'defavorable'
                                                else 'text-bg-warning'}">
                                            <t t-out="dict(membership_file._fields['avis_comite'].selection)[membership_file.avis_comite]"/>
                                        </span>
                                    </p>
                                    <p t-if="membership_file.commentaire_comite" class="text-muted mb-0">
                                        <t t-out="membership_file.commentaire_comite"/>
                                    </p>
                                </t>

                                <t t-if="membership_file.correction_ids">
                                    <h6 class="mt-4">Demandes de correction</h6>
                                    <ul class="list-unstyled">
                                        <li t-foreach="membership_file.correction_ids" t-as="correction"
                                            t-attf-class="#{'text-muted' if correction.resolved else ''}">
                                            <i t-attf-class="fa me-1 #{'fa-check' if correction.resolved else 'fa-exclamation-triangle'}"/>
                                            <t t-if="correction.document_id">
                                                <t t-out="correction.document_id.name"/> —
                                            </t>
                                            <t t-out="correction.motif"/>
                                            <span t-if="correction.resolved" class="badge text-bg-light">traitée</span>
                                        </li>
                                    </ul>
                                </t>

                                <t t-if="membership_file.subscription_ids">
                                    <h6 class="mt-4">Cotisations</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Émise le</th>
                                                    <th>Échéance</th>
                                                    <th class="text-end">Montant</th>
                                                    <th class="text-center">État</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="membership_file.subscription_ids" t-as="subscription">
                                                    <td><span t-field="subscription.date_emission"/></td>
                                                    <td><span t-field="subscription.date_echeance"/></td>
                                                    <td class="text-end"><span t-field="subscription.montant"/></td>
                                                    <td class="text-center"><span t-field="subscription.state"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>

                                <t t-call="opex_membership.membership_history"/>
                            </div>

                            <!-- Vérification de la preuve de paiement (voie B).
                                 Le justificatif est téléchargeable : on ne
                                 confirme pas un encaissement sans avoir pu
                                 regarder la pièce. -->
                            <div t-if="payment_to_verify" class="card-body border-top">
                                <h6>Preuve de paiement à vérifier</h6>
                                <dl class="row mb-3">
                                    <dt class="col-sm-3">Montant déclaré</dt>
                                    <dd class="col-sm-9"><span t-field="payment_to_verify.montant"/></dd>
                                    <dt class="col-sm-3">Date du paiement</dt>
                                    <dd class="col-sm-9"><span t-field="payment_to_verify.date_paiement"/></dd>
                                    <dt t-if="payment_to_verify.reference_transaction" class="col-sm-3">
                                        Référence
                                    </dt>
                                    <dd t-if="payment_to_verify.reference_transaction" class="col-sm-9">
                                        <t t-out="payment_to_verify.reference_transaction"/>
                                    </dd>
                                    <dt class="col-sm-3">Justificatif</dt>
                                    <dd class="col-sm-9">
                                        <a t-attf-href="/web/content?model=opex.payment&amp;id=#{payment_to_verify.id}&amp;field=justificatif&amp;filename_field=justificatif_filename&amp;download=true">
                                            <i class="fa fa-paperclip me-1"/>
                                            <t t-out="payment_to_verify.justificatif_filename or 'Télécharger le justificatif'"/>
                                        </a>
                                    </dd>
                                </dl>
                                <div class="d-flex flex-wrap gap-3 align-items-start">
                                    <form t-attf-action="/staff/membership/#{membership_file.id}/payment/confirm"
                                          method="post" class="mb-0">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-success">
                                            Confirmer le paiement
                                        </button>
                                    </form>
                                    <form t-attf-action="/staff/membership/#{membership_file.id}/payment/reject"
                                          method="post" class="mb-0 flex-grow-1">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <div class="input-group">
                                            <input type="text" name="motif_rejet" class="form-control"
                                                   placeholder="Motif du rejet (obligatoire)"/>
                                            <button type="submit" class="btn btn-outline-danger">
                                                Rejeter
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Vérification de la signature de la charte.
                                 Ce qu'il y a à contrôler dépend de la voie :
                                 un document à ouvrir, ou une confirmation
                                 horodatée à constater. -->
                            <div t-if="signature_to_verify" class="card-body border-top">
                                <h6>Signature de la charte à vérifier</h6>
                                <dl class="row mb-3">
                                    <dt class="col-sm-3">Voie</dt>
                                    <dd class="col-sm-9">
                                        <t t-if="membership_file.signature_mode">
                                            <t t-out="dict(membership_file._fields['signature_mode'].selection)[membership_file.signature_mode]"/>
                                        </t>
                                    </dd>
                                    <dt class="col-sm-3">Date de signature</dt>
                                    <dd class="col-sm-9"><span t-field="membership_file.signature_date"/></dd>
                                    <t t-if="membership_file.signature_mode == 'document'">
                                        <dt class="col-sm-3">Charte signée</dt>
                                        <dd class="col-sm-9">
                                            <a t-attf-href="/web/content?model=opex.membership.file&amp;id=#{membership_file.id}&amp;field=charte_document&amp;filename_field=charte_document_filename&amp;download=true">
                                                <i class="fa fa-paperclip me-1"/>
                                                <t t-out="membership_file.charte_document_filename or 'Télécharger la charte signée'"/>
                                            </a>
                                        </dd>
                                    </t>
                                    <t t-else="">
                                        <dt class="col-sm-3">Nature</dt>
                                        <dd class="col-sm-9 text-muted">
                                            Confirmation électronique horodatée du candidat
                                            (POC : pas de signature cryptographique).
                                        </dd>
                                    </t>
                                </dl>
                                <div class="d-flex flex-wrap gap-3 align-items-start">
                                    <form t-attf-action="/staff/membership/#{membership_file.id}/signature/confirm"
                                          method="post" class="mb-0">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-success">
                                            Confirmer la signature et activer l'adhésion
                                        </button>
                                    </form>
                                    <form t-attf-action="/staff/membership/#{membership_file.id}/signature/reject"
                                          method="post" class="mb-0 flex-grow-1">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <div class="input-group">
                                            <input type="text" name="motif_rejet" class="form-control"
                                                   placeholder="Motif du rejet (obligatoire)"/>
                                            <button type="submit" class="btn btn-outline-danger">
                                                Rejeter
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Demande de correction (section 19) : la pièce
                                 visée, le motif et le commentaire sont exigés
                                 tous les trois — un candidat qui reçoit « à
                                 corriger » sans savoir quoi ni pourquoi ne peut
                                 rien en faire. -->
                            <div t-if="can_request_correction" class="card-body border-top">
                                <h6>Demander une correction au candidat</h6>
                                <form t-attf-action="/staff/membership/#{membership_file.id}/request_correction"
                                      method="post">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <div t-if="membership_file.document_ids" class="mb-3">
                                        <label class="form-label" for="document_id">
                                            Pièce concernée *
                                        </label>
                                        <select name="document_id" id="document_id" class="form-select">
                                            <option value="">Choisissez la pièce…</option>
                                            <option t-foreach="membership_file.document_ids" t-as="document"
                                                    t-att-value="document.id">
                                                <t t-out="document.name"/>
                                                (<t t-out="dict(document._fields['document_type'].selection)[document.document_type]"/>)
                                            </option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="motif">Motif *</label>
                                        <input type="text" name="motif" id="motif" class="form-control"
                                               placeholder="ex. Le document fourni est illisible."/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="commentaire">Commentaire *</label>
                                        <textarea name="commentaire" id="commentaire" class="form-control" rows="3"
                                                  placeholder="ex. Veuillez fournir une nouvelle copie."/>
                                    </div>
                                    <button type="submit" class="btn btn-warning">
                                        Envoyer la demande
                                    </button>
                                </form>
                            </div>

                            <!-- Formulaire d'avis du Comité : trois choix
                                 exclusifs et un commentaire, comme la
                                 section 21. Il précède le pied de carte parce
                                 qu'il ne se réduit pas à un bouton. -->
                            <div t-if="can_record_avis" class="card-body border-top">
                                <h6>Avis du Comité d'admission</h6>
                                <form t-attf-action="/staff/membership/#{membership_file.id}/avis"
                                      method="post">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="avis_comite"
                                               id="avis_favorable" value="favorable"/>
                                        <label class="form-check-label" for="avis_favorable">
                                            Favorable — transmettre au COPIL
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="avis_comite"
                                               id="avis_defavorable" value="defavorable"/>
                                        <label class="form-check-label" for="avis_defavorable">
                                            Défavorable — mettre fin au parcours
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="avis_comite"
                                               id="avis_complement" value="complement"/>
                                        <label class="form-check-label" for="avis_complement">
                                            Demande de complément — renvoyer au candidat
                                        </label>
                                    </div>
                                    <div class="mt-3">
                                        <label class="form-label" for="commentaire_comite">
                                            Commentaire
                                        </label>
                                        <textarea name="commentaire_comite" id="commentaire_comite"
                                                  class="form-control" rows="3"/>
                                        <small class="form-text text-muted">
                                            Obligatoire pour une demande de complément : ce texte est
                                            transmis au candidat.
                                        </small>
                                    </div>
                                    <button type="submit" class="btn btn-primary mt-3">
                                        Enregistrer l'avis
                                    </button>
                                </form>
                            </div>

                            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <t t-if="transition">
                                    <span class="text-muted">
                                        Ce dossier attend votre validation.
                                    </span>
                                    <form t-attf-action="/staff/membership/#{membership_file.id}/validate"
                                          method="post" class="mb-0">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-primary">
                                            <t t-out="transition['label']"/>
                                        </button>
                                    </form>
                                </t>
                                <t t-elif="payable_subscription">
                                    <span class="text-muted">
                                        Cotisation de
                                        <span t-field="payable_subscription.montant"/>
                                        en attente de règlement — l'enregistrer solde le reste dû
                                        et fait passer le dossier à la signature de la charte.
                                    </span>
                                    <form t-attf-action="/staff/membership/#{membership_file.id}/register_payment"
                                          method="post" class="mb-0">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-primary">
                                            Enregistrer le paiement
                                        </button>
                                    </form>
                                </t>
                                <!-- L'avis du Comité se saisit dans le bloc
                                     ci-dessus : ne pas annoncer ici qu'il n'y a
                                     rien à faire alors que le formulaire attend. -->
                                <span t-elif="can_record_avis" class="text-muted">
                                    Rendez votre avis dans le formulaire ci-dessus.
                                </span>
                                <span t-elif="payment_to_verify" class="text-muted">
                                    Vérifiez la preuve de paiement dans le bloc ci-dessus.
                                </span>
                                <span t-elif="signature_to_verify" class="text-muted">
                                    Vérifiez la charte signée dans le bloc ci-dessus.
                                </span>
                                <span t-elif="can_request_correction" class="text-muted">
                                    Vous pouvez demander une correction au candidat ci-dessus.
                                </span>
                                <span t-else="" class="text-muted">
                                    Aucune action ne vous revient sur ce dossier à son état actuel.
                                </span>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>

</odoo>
