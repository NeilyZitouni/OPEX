<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_opex_subscription_list" model="ir.ui.view">
        <field name="name">opex.subscription.list</field>
        <field name="model">opex.subscription</field>
        <field name="arch" type="xml">
            <list string="Cotisations">
                <field name="partner_id"/>
                <field name="date_emission"/>
                <field name="date_echeance"/>
                <field name="sale_order_id"/>
                <field name="montant"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_opex_subscription_form" model="ir.ui.view">
        <field name="name">opex.subscription.form</field>
        <field name="model">opex.subscription</field>
        <field name="arch" type="xml">
            <form string="Cotisation">
                <header>
                    <button name="action_register_payment" type="object" string="Enregistrer un paiement"
                            class="oe_highlight" invisible="state not in ('waiting', 'late')"/>
                    <button name="action_generate_reminder" type="object" string="Envoyer une relance"
                            invisible="state != 'late'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="montant"/>
                        </group>
                        <group>
                            <field name="date_emission"/>
                            <field name="date_echeance"/>
                            <field name="sale_order_id"/>
                            <field name="membership_file_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Paiements" name="payments">
                            <field name="payment_ids">
                                <list editable="bottom">
                                    <field name="date_paiement"/>
                                    <field name="montant"/>
                                    <field name="mode_paiement"/>
                                    <field name="reference_transaction"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_opex_subscription" model="ir.actions.act_window">
        <field name="name">Cotisations</field>
        <field name="res_model">opex.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
