<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Carte "Mes dossiers d'adhésion" sur l'accueil du portail -->
    <template id="portal_my_home_membership" name="Portail : mes dossiers d'adhésion"
              customize_show="True" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Mes dossiers d'adhésion</t>
                <t t-set="text">Déposer et suivre ma demande d'adhésion au cluster</t>
                <t t-set="url" t-value="'/my/membership'"/>
                <t t-set="placeholder_count" t-value="'membership_file_count'"/>
            </t>
        </div>
    </template>

    <!-- Fil d'Ariane -->
    <template id="portal_breadcrumbs_membership" name="Portail : fil d'Ariane adhésion"
              inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('membership', 'membership_new')"
                t-attf-class="breadcrumb-item #{'active ' if not membership_file and page_name != 'membership_new' else ''}">
                <a t-if="membership_file or page_name == 'membership_new'" href="/my/membership">Dossiers d'adhésion</a>
                <t t-else="">Dossiers d'adhésion</t>
            </li>
            <li t-if="page_name == 'membership_new'" class="breadcrumb-item active">
                Nouveau dossier
            </li>
            <li t-if="membership_file" class="breadcrumb-item active">
                Dossier n° <t t-out="membership_file.id"/>
            </li>
        </xpath>
    </template>

    <!-- Pastille d'état, réutilisée par la liste et le détail -->
    <template id="portal_membership_state_badge" name="Portail : état du dossier">
        <span t-attf-class="badge rounded-pill #{
                'text-bg-success' if membership_file.state == 'active'
                else 'text-bg-danger' if membership_file.is_rejected()
                else 'text-bg-info' if membership_file.state in ('copil_validated', 'signature_pending')
                else 'text-bg-secondary' if membership_file.state == 'draft'
                else 'text-bg-warning'}">
            <t t-out="membership_file._state_label()"/>
        </span>
    </template>

    <!-- /my/membership : liste des dossiers du candidat -->
    <template id="portal_my_membership_files" name="Portail : mes dossiers d'adhésion">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mes dossiers d'adhésion</t>
            </t>

            <div class="mb-4">
                <a href="/my/membership/new" class="btn btn-primary">
                    <i class="fa fa-plus me-1"/>Déposer un dossier d'adhésion
                </a>
            </div>

            <div t-if="not membership_files" class="alert alert-info" role="alert">
                Vous n'avez encore déposé aucun dossier d'adhésion.
            </div>

            <t t-if="membership_files" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Dossier</th>
                        <th>Catégorie demandée</th>
                        <th class="text-end">Date de dépôt</th>
                        <th class="text-center">État</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="membership_files" t-as="membership_file">
                        <td>
                            <a t-attf-href="/my/membership/#{membership_file.id}">
                                Dossier n° <t t-out="membership_file.id"/>
                            </a>
                        </td>
                        <td><span t-field="membership_file.subcategory_id"/></td>
                        <td class="text-end">
                            <span t-field="membership_file.date_depot" t-options="{'widget': 'date'}"/>
                        </td>
                        <td class="text-center">
                            <t t-call="opex_membership.portal_membership_state_badge"/>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <!-- /my/membership/new : formulaire de dépôt -->
    <template id="portal_membership_file_new" name="Portail : déposer un dossier d'adhésion">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Déposer un dossier d'adhésion</t>
            </t>

            <div t-if="errors" class="alert alert-danger" role="alert">
                Votre dossier n'a pas pu être enregistré, merci de corriger les points signalés ci-dessous.
            </div>

            <!-- Ne pas remettre `o_portal_details` sur ce formulaire : en v19 cette
                 classe n'a plus aucun style, c'est uniquement le sélecteur de
                 l'interaction `portal.portal_details`, qui suppose un formulaire
                 d'adresse et déréférence `select[name=country_id]` sans le tester. -->
            <form action="/my/membership/new" method="post" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="col-form-label" for="candidate_name">Candidat</label>
                        <input type="text" id="candidate_name" class="form-control" disabled="disabled"
                               t-att-value="partner.name"/>
                        <small class="form-text text-muted">
                            Le dossier est déposé au nom de votre compte. Pour corriger ces informations,
                            passez par <a href="/my/account">Mon compte</a>.
                        </small>
                    </div>

                    <div class="col-12">
                        <label class="col-form-label" for="subcategory_id">Sous-catégorie d'adhésion souhaitée</label>
                        <!-- Catégorie et sous-catégorie sur un seul écran pour
                             l'instant ; le choix en deux temps de la section 6
                             fait partie du parcours en étapes (Extension 10). -->
                        <select name="subcategory_id" id="subcategory_id"
                                t-attf-class="form-select #{'is-invalid' if errors.get('subcategory_id') else ''}">
                            <option value="">Choisissez une sous-catégorie…</option>
                            <t t-foreach="categories" t-as="category">
                                <optgroup t-att-label="category.name">
                                    <option t-foreach="category.subcategory_ids" t-as="subcategory"
                                            t-att-value="subcategory.id"
                                            t-att-selected="'selected' if form.get('subcategory_id') == str(subcategory.id) else None">
                                        <t t-out="subcategory.name"/>
                                        <t t-if="subcategory.critere_eligibilite">
                                            — <t t-out="subcategory.critere_eligibilite"/>
                                        </t>
                                    </option>
                                </optgroup>
                            </t>
                        </select>
                        <div t-if="errors.get('subcategory_id')" class="invalid-feedback d-block">
                            <t t-out="errors['subcategory_id']"/>
                        </div>
                    </div>

                    <div class="col-12"><hr class="my-2"/><h5>Informations de l'organisation</h5></div>

                    <div class="col-md-6">
                        <label class="col-form-label" for="nom_legal">Nom légal *</label>
                        <input type="text" name="nom_legal" id="nom_legal"
                               t-attf-class="form-control #{'is-invalid' if errors.get('nom_legal') else ''}"
                               t-att-value="form.get('nom_legal') or ''"/>
                        <div t-if="errors.get('nom_legal')" class="invalid-feedback d-block">
                            <t t-out="errors['nom_legal']"/>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="col-form-label" for="nom_commercial">Nom commercial</label>
                        <input type="text" name="nom_commercial" id="nom_commercial" class="form-control"
                               t-att-value="form.get('nom_commercial') or ''"/>
                    </div>

                    <div class="col-md-6">
                        <label class="col-form-label" for="forme_juridique">Forme juridique</label>
                        <input type="text" name="forme_juridique" id="forme_juridique" class="form-control"
                               t-att-value="form.get('forme_juridique') or ''"/>
                    </div>

                    <div class="col-md-3">
                        <label class="col-form-label" for="nif">NIF</label>
                        <input type="text" name="nif" id="nif" class="form-control"
                               t-att-value="form.get('nif') or ''"/>
                    </div>

                    <div class="col-md-3">
                        <label class="col-form-label" for="rc">RC</label>
                        <input type="text" name="rc" id="rc" class="form-control"
                               t-att-value="form.get('rc') or ''"/>
                    </div>

                    <div class="col-12">
                        <label class="col-form-label" for="adresse">Adresse</label>
                        <input type="text" name="adresse" id="adresse" class="form-control"
                               t-att-value="form.get('adresse') or ''"/>
                    </div>

                    <div class="col-md-6">
                        <label class="col-form-label" for="wilaya">Wilaya</label>
                        <input type="text" name="wilaya" id="wilaya" class="form-control"
                               t-att-value="form.get('wilaya') or partner.wilaya or ''"/>
                    </div>

                    <div class="col-md-6">
                        <label class="col-form-label" for="commune">Commune</label>
                        <input type="text" name="commune" id="commune" class="form-control"
                               t-att-value="form.get('commune') or ''"/>
                    </div>

                    <div class="col-md-4">
                        <label class="col-form-label" for="site_web">Site web</label>
                        <input type="text" name="site_web" id="site_web" class="form-control"
                               t-att-value="form.get('site_web') or ''"/>
                    </div>

                    <div class="col-md-4">
                        <label class="col-form-label" for="email_pro">Email professionnel</label>
                        <input type="email" name="email_pro" id="email_pro" class="form-control"
                               t-att-value="form.get('email_pro') or ''"/>
                    </div>

                    <div class="col-md-4">
                        <label class="col-form-label" for="telephone">Téléphone</label>
                        <input type="text" name="telephone" id="telephone" class="form-control"
                               t-att-value="form.get('telephone') or ''"/>
                    </div>

                    <div class="col-12"><hr class="my-2"/><h5>Activité</h5></div>

                    <div class="col-md-6">
                        <label class="col-form-label" for="secteur_activite">Secteur d'activité</label>
                        <input type="text" name="secteur_activite" id="secteur_activite" class="form-control"
                               t-att-value="form.get('secteur_activite') or partner.secteur_activite or ''"/>
                    </div>

                    <div class="col-md-6">
                        <label class="col-form-label" for="activite_principale">Activité principale</label>
                        <input type="text" name="activite_principale" id="activite_principale" class="form-control"
                               t-att-value="form.get('activite_principale') or ''"/>
                    </div>

                    <div class="col-12"><hr class="my-2"/><h5>Représentant de l'organisation</h5></div>

                    <div class="col-md-4">
                        <label class="col-form-label" for="representant_nom">Nom</label>
                        <input type="text" name="representant_nom" id="representant_nom" class="form-control"
                               t-att-value="form.get('representant_nom') or ''"/>
                    </div>

                    <div class="col-md-4">
                        <label class="col-form-label" for="representant_prenom">Prénom</label>
                        <input type="text" name="representant_prenom" id="representant_prenom" class="form-control"
                               t-att-value="form.get('representant_prenom') or ''"/>
                    </div>

                    <div class="col-md-4">
                        <label class="col-form-label" for="representant_fonction">Fonction</label>
                        <input type="text" name="representant_fonction" id="representant_fonction" class="form-control"
                               t-att-value="form.get('representant_fonction') or ''"/>
                    </div>

                    <div class="col-md-6">
                        <label class="col-form-label" for="representant_email">Email</label>
                        <input type="email" name="representant_email" id="representant_email" class="form-control"
                               t-att-value="form.get('representant_email') or ''"/>
                    </div>

                    <div class="col-md-6">
                        <label class="col-form-label" for="representant_telephone">Téléphone</label>
                        <input type="text" name="representant_telephone" id="representant_telephone" class="form-control"
                               t-att-value="form.get('representant_telephone') or ''"/>
                    </div>

                    <div class="col-12">
                        <label class="col-form-label" for="motivation">
                            Pourquoi souhaitez-vous rejoindre le GIC OPEX Group ?
                        </label>
                        <textarea name="motivation" id="motivation" class="form-control" rows="3">
                            <t t-out="form.get('motivation') or ''"/>
                        </textarea>
                    </div>

                    <div class="col-12"><hr class="my-2"/><h5>Pièces du dossier</h5></div>

                    <!-- Chaque pièce a son propre champ : c'est le champ, et non
                         le nom du fichier, qui détermine le type de la pièce et
                         donc la complétude du dossier. -->
                    <div t-foreach="document_slots" t-as="slot" class="col-md-6">
                        <label class="col-form-label" t-attf-for="document_#{slot[0]}">
                            <t t-out="slot[1]"/>
                            <span t-if="slot[2]" class="text-danger"> *</span>
                            <span t-else="" class="text-muted small"> (optionnel)</span>
                        </label>
                        <input type="file" t-attf-name="document_#{slot[0]}"
                               t-attf-id="document_#{slot[0]}" class="form-control"/>
                    </div>

                    <div class="col-12">
                        <small class="form-text text-muted">
                            Les pièces marquées d'une étoile sont obligatoires : votre dossier
                            ne pourra pas être soumis au Secrétariat tant qu'elles manquent.
                            Vous pouvez enregistrer votre dossier en brouillon et les ajouter plus tard.
                        </small>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Enregistrer le dossier</button>
                    <a href="/my/membership" class="btn btn-light">Annuler</a>
                </div>
            </form>
        </t>
    </template>

    <!-- /my/membership/<id> : détail en lecture seule -->
    <template id="portal_membership_file_page" name="Portail : détail du dossier d'adhésion">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mon dossier d'adhésion</t>
            </t>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0">Dossier n° <t t-out="membership_file.id"/></h5>
                    <t t-call="opex_membership.portal_membership_state_badge"/>
                </div>

                <div class="card-body">
                    <!--
                        Règle d'or de la spécification (section 47) : le candidat
                        ne doit pas voir la complexité interne. Les treize états
                        du workflow sont donc regroupés en les sept étapes
                        lisibles de la section 16 — « Paiement à vérifier » et
                        « Paiement en attente » sont, pour lui, la même étape.
                    -->
                    <t t-set="steps" t-value="[
                        ('Dossier déposé', ['draft']),
                        ('Contrôle du Secrétariat', ['control', 'correction_requested']),
                        (&quot;Comité d'admission&quot;, ['committee']),
                        ('Validation COPIL', ['copil_pending', 'copil_validated']),
                        ('Paiement', ['payment_pending', 'payment_verification']),
                        ('Signature de la charte', ['signature_pending']),
                        ('Activation', ['active']),
                    ]"/>
                    <t t-set="matches"
                       t-value="[index for index, step in enumerate(steps) if membership_file.state in step[1]]"/>
                    <t t-set="current_index" t-value="matches[0] if matches else -1"/>

                    <div t-if="membership_file.is_rejected()" class="alert alert-danger" role="alert">
                        <strong>Votre demande d'adhésion n'a pas été retenue.</strong>
                        <div class="small mb-0">
                            Le Secrétariat du GIC OPEX Group reste à votre disposition pour vous
                            en préciser les motifs.
                        </div>
                    </div>

                    <ol t-else="" class="list-unstyled d-flex flex-wrap gap-3 mb-4">
                        <li t-foreach="steps" t-as="step" class="d-flex align-items-center gap-2">
                            <i t-attf-class="fa #{
                                'fa-check-circle text-success' if step_index &lt; current_index
                                else 'fa-dot-circle-o text-primary' if step_index == current_index
                                else 'fa-circle-o text-muted'}"/>
                            <span t-attf-class="#{'fw-bold' if step_index == current_index else 'text-muted'}">
                                <t t-out="step[0]"/>
                            </span>
                        </li>
                    </ol>

                    <!-- Erreur remontée telle quelle par le modèle (pièce
                         obligatoire manquante, transition refusée) : le
                         candidat doit lire ce qui bloque, pas une page
                         d'erreur technique. -->
                    <div t-if="error" class="alert alert-danger" role="alert">
                        <t t-out="error"/>
                    </div>

                    <!-- Demandes de correction encore ouvertes : le candidat doit
                         savoir ce qu'on attend de lui. -->
                    <t t-set="open_corrections"
                       t-value="membership_file.correction_ids.filtered(lambda c: not c.resolved)"/>
                    <div t-if="open_corrections" class="alert alert-warning" role="alert">
                        <strong>Votre dossier nécessite une correction</strong>
                        <ul class="mb-0 mt-2">
                            <li t-foreach="open_corrections" t-as="correction">
                                <t t-if="correction.document_id">
                                    <span t-field="correction.document_id.name"/> —
                                </t>
                                <t t-out="correction.motif"/>
                                <div t-if="correction.commentaire" class="small text-muted">
                                    <t t-out="correction.commentaire"/>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Remplacement des pièces visées par une correction, et
                         dépôt de celles qui manquent encore. `mapped` dédoublonne :
                         deux corrections sur la même pièce ne donnent qu'un champ. -->
                    <t t-if="membership_file.state == 'correction_requested'">
                        <t t-set="documents_to_replace" t-value="open_corrections.mapped('document_id')"/>
                        <div t-if="documents_to_replace or missing_slots" class="card bg-light mb-4">
                            <div class="card-body">
                                <h6 class="card-title">Mettre à jour mes pièces</h6>
                                <form t-attf-action="/my/membership/#{membership_file.id}/documents"
                                      method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <div class="row g-3">
                                        <div t-foreach="documents_to_replace" t-as="document"
                                             class="col-md-6">
                                            <label class="form-label"
                                                   t-attf-for="replace_#{document.id}">
                                                Remplacer « <t t-out="document.name"/> »
                                            </label>
                                            <input type="file" class="form-control"
                                                   t-attf-name="replace_#{document.id}"
                                                   t-attf-id="replace_#{document.id}"/>
                                        </div>
                                        <div t-foreach="missing_slots" t-as="slot" class="col-md-6">
                                            <label class="form-label"
                                                   t-attf-for="document_#{slot[0]}">
                                                <t t-out="slot[1]"/>
                                                <span class="text-danger"> * manquante</span>
                                            </label>
                                            <input type="file" class="form-control"
                                                   t-attf-name="document_#{slot[0]}"
                                                   t-attf-id="document_#{slot[0]}"/>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-secondary mt-3">
                                        Téléverser les pièces
                                    </button>
                                </form>
                            </div>
                        </div>
                    </t>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong>Organisation</strong>
                            <div><t t-out="membership_file.nom_legal or membership_file.partner_id.name"/></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Catégorie demandée</strong>
                            <div><span t-field="membership_file.subcategory_id"/></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Date de dépôt</strong>
                            <div><span t-field="membership_file.date_depot"/></div>
                        </div>
                        <div t-if="membership_file.signature_date" class="col-md-6 mb-3">
                            <strong>Date de signature de la charte</strong>
                            <div><span t-field="membership_file.signature_date"/></div>
                        </div>
                    </div>

                    <h6 class="mt-3">Pièces jointes</h6>
                    <div t-if="not membership_file.document_ids" class="text-muted">
                        Aucune pièce jointe pour l'instant.
                    </div>
                    <ul t-else="" class="list-unstyled">
                        <li t-foreach="membership_file.document_ids" t-as="document">
                            <i class="fa fa-paperclip me-1"/>
                            <t t-out="document.name"/>
                            <span class="text-muted small">
                                — <t t-out="dict(document._fields['document_type'].selection)[document.document_type]"/>
                            </span>
                            <span t-if="document.is_required" class="badge text-bg-light">obligatoire</span>
                        </li>
                    </ul>

                    <!-- Pièces obligatoires manquantes : dit au candidat ce qui
                         bloque son dépôt, plutôt que de le lui apprendre par un
                         message d'erreur au moment de soumettre. -->
                    <t t-set="missing" t-value="membership_file._missing_required_documents()"/>
                    <div t-if="missing and membership_file.state in ('draft', 'correction_requested')"
                         class="alert alert-warning mt-2 mb-0" role="alert">
                        Pièces obligatoires encore manquantes :
                        <t t-out="', '.join(missing)"/>.
                    </div>

                    <!--
                        Paiement de la cotisation (section 24). Les deux voies
                        sont proposées côte à côte : régler en ligne, ou
                        déclarer un paiement déjà effectué hors du portail.
                    -->
                    <t t-if="membership_file.state == 'payment_pending' and pending_subscription">
                        <div class="card border-primary mb-4">
                            <div class="card-body">
                                <h6 class="card-title">Payer ma cotisation</h6>
                                <p>
                                    Montant :
                                    <strong><span t-field="pending_subscription.montant"/></strong>
                                    <t t-if="pending_subscription.date_echeance">
                                        — à régler avant le
                                        <span t-field="pending_subscription.date_echeance"/>
                                    </t>
                                </p>

                                <!-- Preuve précédemment rejetée : dire pourquoi
                                     avant de redemander un justificatif. -->
                                <div t-if="rejected_payment" class="alert alert-danger" role="alert">
                                    <strong>Votre précédente preuve de paiement a été rejetée.</strong>
                                    <div t-if="rejected_payment.motif_rejet" class="small mb-0">
                                        <t t-out="rejected_payment.motif_rejet"/>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-5">
                                        <h6 class="text-muted">Payer en ligne</h6>
                                        <a t-if="online_payment_url" t-att-href="online_payment_url"
                                           class="btn btn-primary">
                                            Payer maintenant
                                        </a>
                                        <p t-else="" class="text-muted small mb-0">
                                            Le paiement en ligne n'est pas disponible pour cette cotisation.
                                        </p>
                                    </div>

                                    <div class="col-md-7 border-start">
                                        <h6 class="text-muted">J'ai déjà payé</h6>
                                        <form t-attf-action="/my/membership/#{membership_file.id}/payment_proof"
                                              method="post" enctype="multipart/form-data">
                                            <input type="hidden" name="csrf_token"
                                                   t-att-value="request.csrf_token()"/>
                                            <div class="row g-2">
                                                <div class="col-sm-6">
                                                    <label class="form-label" for="reference_paiement">
                                                        Référence du paiement
                                                    </label>
                                                    <input type="text" name="reference_paiement"
                                                           id="reference_paiement" class="form-control"/>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-label" for="date_paiement">
                                                        Date du paiement
                                                    </label>
                                                    <input type="date" name="date_paiement"
                                                           id="date_paiement" class="form-control"/>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-label" for="montant">Montant *</label>
                                                    <input type="text" name="montant" id="montant"
                                                           class="form-control"
                                                           t-att-value="pending_subscription.montant"/>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-label" for="justificatif">
                                                        Justificatif *
                                                    </label>
                                                    <input type="file" name="justificatif"
                                                           id="justificatif" class="form-control"/>
                                                </div>
                                            </div>
                                            <button type="submit" class="btn btn-secondary mt-3">
                                                Envoyer ma preuve de paiement
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Règle d'or (section 47) : dire au candidat qu'il n'a
                         rien à faire, plutôt que de le laisser devant un état. -->
                    <div t-if="membership_file.state == 'payment_verification'"
                         class="alert alert-info" role="alert">
                        <strong>Votre preuve de paiement est en cours de vérification.</strong>
                        <div class="small mb-0">
                            Le Secrétariat contrôle votre justificatif
                            <t t-if="payment_to_verify and payment_to_verify.justificatif_filename">
                                (« <t t-out="payment_to_verify.justificatif_filename"/> »)
                            </t>.
                            Vous n'avez rien à faire pour le moment.
                        </div>
                    </div>

                    <t t-if="membership_file.subscription_ids">
                        <h6 class="mt-4">Cotisations</h6>
                        <t t-call="portal.portal_table">
                            <t t-set="pager" t-value="False"/>
                            <thead>
                                <tr class="active">
                                    <th>Émise le</th>
                                    <th>Échéance</th>
                                    <th class="text-end">Montant</th>
                                    <th class="text-center">État</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="membership_file.subscription_ids" t-as="subscription">
                                    <td><span t-field="subscription.date_emission"/></td>
                                    <td><span t-field="subscription.date_echeance"/></td>
                                    <td class="text-end"><span t-field="subscription.montant"/></td>
                                    <td class="text-center"><span t-field="subscription.state"/></td>
                                </tr>
                            </tbody>
                        </t>
                    </t>
                </div>

                <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <t t-if="membership_file.state == 'draft'">
                        <span class="text-muted">
                            Votre dossier est encore modifiable. Soumettez-le pour qu'il parte au contrôle du Secrétariat.
                        </span>
                        <form t-attf-action="/my/membership/#{membership_file.id}/submit" method="post" class="mb-0">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary">Soumettre le dossier</button>
                        </form>
                    </t>
                    <!-- Un dossier en correction est modifiable : lui appliquer
                         le message « plus modifiable » dirait au candidat
                         l'inverse de ce qu'on attend de lui. -->
                    <t t-elif="membership_file.state == 'correction_requested'">
                        <span class="text-muted">
                            Une fois vos pièces mises à jour, renvoyez votre dossier au Secrétariat.
                        </span>
                        <form t-attf-action="/my/membership/#{membership_file.id}/resubmit"
                              method="post" class="mb-0">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary">Renvoyer mon dossier</button>
                        </form>
                    </t>
                    <span t-else="" class="text-muted">
                        Votre dossier est en cours de traitement : il n'est plus modifiable.
                        Vous serez notifié à chaque étape.
                    </span>
                </div>
            </div>
        </t>
    </template>

</odoo>
