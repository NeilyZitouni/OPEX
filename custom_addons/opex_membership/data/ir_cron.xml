<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Relances automatiques des cotisations (section 30).

        `noupdate="1"` : l'Administrateur peut changer la fréquence ou
        désactiver l'action depuis l'interface sans qu'une mise à jour du
        module ne rétablisse ses valeurs.

        Cadence quotidienne : la spécification ne demande aucune réactivité
        particulière, et le traitement est idempotent — une cotisation déjà
        relancée n'est pas reprise au passage suivant.
    -->
    <data noupdate="1">

        <record id="ir_cron_subscription_reminders" model="ir.cron">
            <field name="name">OPEX Membership : relances de cotisation</field>
            <field name="model_id" ref="model_opex_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Délai de la relance avant échéance, en jours. -->
        <record id="config_relance_jours_avant" model="ir.config_parameter">
            <field name="key">opex_membership.relance_jours_avant</field>
            <field name="value">15</field>
        </record>

    </data>
</odoo>
