<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crowdfunding_project_list" model="ir.ui.view">
        <field name="name">opex.crowdfunding.project.list</field>
        <field name="model">opex.crowdfunding.project</field>
        <field name="arch" type="xml">
            <list string="Projets Smart Crowdfunding">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="porteur_type" optional="show"/>
                <field name="secteur" optional="show"/>
                <field name="besoin_type" optional="show"/>
                <field name="montant_indicatif" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="create_date" string="Déposé le" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('closing', 'closed')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_crowdfunding_project_form" model="ir.ui.view">
        <field name="name">opex.crowdfunding.project.form</field>
        <field name="model">opex.crowdfunding.project</field>
        <field name="arch" type="xml">
            <form string="Projet Smart Crowdfunding">
                <header>
                    <button name="action_submit" type="object" string="Présenter mon projet"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <!--
                        Les états de sortie (« Non retenu », « Clôturé ») et les
                        états de retour au porteur ne figurent pas dans la barre
                        d'avancement : un dossier en clarification n'a pas
                        reculé dans le parcours, il attend une réponse.
                    -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,depot_express,pre_analyse,dossier_progressif,quality_gate,etude_decision,matching_financier,mise_en_relation,decision_financeur,closing"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Titre du projet"/>
                        <h1><field name="name" placeholder="Le projet en une ligne"/></h1>
                    </div>
                    <group>
                        <group string="Le porteur">
                            <field name="partner_id"/>
                            <field name="porteur_type"/>
                        </group>
                        <group string="Le besoin">
                            <field name="besoin_type"/>
                            <field name="montant_indicatif"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Le projet">
                            <field name="secteur"/>
                            <field name="maturite"/>
                        </group>
                        <group string="Suivi">
                            <field name="score"/>
                            <field name="ceo_approval"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Présentation" name="presentation">
                            <group>
                                <field name="probleme" placeholder="Quel problème ou quelle opportunité ?"/>
                                <field name="solution" placeholder="La solution proposée."/>
                            </group>
                            <group string="Document / pitch (facultatif)">
                                <field name="pitch_document" filename="pitch_filename"/>
                                <field name="pitch_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_crowdfunding_project_search" model="ir.ui.view">
        <field name="name">opex.crowdfunding.project.search</field>
        <field name="model">opex.crowdfunding.project</field>
        <field name="arch" type="xml">
            <search string="Projets">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Brouillons" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_en_cours" string="En cours"
                        domain="[('state', 'not in', ('draft', 'closed', 'rejected'))]"/>
                <filter name="filter_rejected" string="Non retenus" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_secteur" string="Secteur" context="{'group_by': 'secteur'}"/>
                    <filter name="group_besoin" string="Besoin" context="{'group_by': 'besoin_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crowdfunding_project" model="ir.actions.act_window">
        <field name="name">Projets</field>
        <field name="res_model">opex.crowdfunding.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crowdfunding_project_search"/>
        <field name="context">{'search_default_filter_en_cours': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun projet déposé pour l'instant.
            </p>
            <p>
                Les porteurs déposent leur projet depuis le portail ; les dossiers
                arrivent ici dès qu'ils sont présentés.
            </p>
        </field>
    </record>

</odoo>
