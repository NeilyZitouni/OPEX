<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crowdfunding_criteria_list" model="ir.ui.view">
        <field name="name">opex.crowdfunding.criteria.list</field>
        <field name="model">opex.crowdfunding.criteria</field>
        <field name="arch" type="xml">
            <list string="Critères de pré-analyse" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_crowdfunding_criteria" model="ir.actions.act_window">
        <field name="name">Critères de pré-analyse</field>
        <field name="res_model">opex.crowdfunding.criteria</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Définissez les critères de validation préliminaire.
            </p>
            <p>
                Ces critères sont ceux que le comité coche en pré-analyse. Les
                modifier ne demande pas de développeur.
            </p>
        </field>
    </record>

</odoo>
